typeset -U path
path=("$HOME/.local/bin" $path)

[[ -f ~/.local/state/theme/starship.toml ]] && export STARSHIP_CONFIG=~/.local/state/theme/starship.toml
eval "$(starship init zsh)"

export EZA_COLORS="uu=bright-black:gu=bright-black:da=bright-black:ur=white:uw=bright-black:ux=white:ue=bright-black:gr=bright-black:gw=bright-black:gx=white:tr=bright-black:fi=white:di=bright-white:ln=bright-black:pi=bright-black:so=bright-black:bd=bright-black:cd=bright-black:or=bright-black:mi=bright-black:ex=white"

alias ls='eza --icons=auto'
alias ll='eza -lah --icons=auto --git'
alias la='eza -a --icons=auto'
alias lt='eza --tree --icons=auto'

autoload -Uz compinit
compinit

zstyle ':completion:*' menu select

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

zstyle ':completion:*' list-colors \
  '=(#b)*(=0)=38;5;250' \
  '=(#b)*(=1)=38;5;255' \
  '=(#b)*(=2)=38;5;245' \
  '=(#b)*(=3)=38;5;240'

ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'

HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS

for f in /usr/share/{zsh/plugins/,}zsh-autosuggestions/zsh-autosuggestions.zsh; do [[ -r $f ]] && source $f && break; done

for f in /usr/share/{zsh/plugins/,}zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; do [[ -r $f ]] && source $f && break; done

ZSH_HIGHLIGHT_STYLES[command]='fg=white'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=white'
ZSH_HIGHLIGHT_STYLES[function]='fg=white'
ZSH_HIGHLIGHT_STYLES[alias]='fg=white'
ZSH_HIGHLIGHT_STYLES[path]='fg=245'
ZSH_HIGHLIGHT_STYLES[comment]='fg=240'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=245'

zmodload -F zsh/stat b:zstat
theme_colors=~/.local/state/theme/zsh-colors.zsh
theme_colors_mtime=
load_theme_colors() {
  local -a mtime
  zstat -A mtime +mtime $theme_colors 2>/dev/null || return 0
  [[ $mtime[1] == $theme_colors_mtime ]] && return 0
  theme_colors_mtime=$mtime[1]
  source $theme_colors
}
load_theme_colors
autoload -Uz add-zsh-hook
add-zsh-hook precmd load_theme_colors

[[ -f ~/.local/state/theme/lazygit.yml ]] && export LG_CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/lazygit/config.yml,$HOME/.local/state/theme/lazygit.yml"

eval "$(zoxide init zsh --cmd cd)"

if [[ -n $FASTFETCH ]]; then
  unset FASTFETCH
  fastfetch
fi

command -v mise >/dev/null && eval "$(mise activate zsh)"

_pikadots_starship=${commands[starship]} _pikadots_mise=${commands[mise]} _pikadots_zoxide=${commands[zoxide]}
_pikadots_unhook() {
  local exit_status=$?
  if [[ -n $_pikadots_starship && ! -x $_pikadots_starship ]]; then
    _pikadots_starship=
    precmd_functions=(${precmd_functions:#prompt_starship_precmd})
    preexec_functions=(${preexec_functions:#prompt_starship_preexec})
    PROMPT='%n@%m:%~%# ' RPROMPT= PROMPT2='> '
  fi
  if [[ -n $_pikadots_mise && ! -x $_pikadots_mise ]]; then
    _pikadots_mise=
    add-zsh-hook -d precmd _mise_hook_precmd
    add-zsh-hook -d chpwd _mise_hook_chpwd
  fi
  if [[ -n $_pikadots_zoxide && ! -x $_pikadots_zoxide ]]; then
    _pikadots_zoxide=
    chpwd_functions=(${chpwd_functions:#__zoxide_hook})
    __zoxide_z() { builtin cd "$@" }
    __zoxide_zi() { builtin cd "$@" }
  fi
  return $exit_status
}
precmd_functions=(_pikadots_unhook $precmd_functions)
