#!/usr/bin/env bash
set -uo pipefail

self=$(readlink -f "${BASH_SOURCE[0]}")
. "$(dirname "$self")/../hypr/scripts/lib.sh" || { echo "pikadots: can't read hypr/scripts/lib.sh next to $self" >&2; exit 1; }
repo=$(pikadots_repo)
pkgdir=$repo/config
state=$HOME/.local/state/pikadots
backups=$state/backups

links=(
	"hypr .config/hypr"
	"quickshell .config/quickshell"
	"kitty .config/kitty"
	"matugen .config/matugen"
	"fastfetch .config/fastfetch"
	"fontconfig .config/fontconfig"
	"fuzzel .config/fuzzel"
	"git .config/git"
	"lazygit/config.yml .config/lazygit/config.yml"
	"btop/btop.conf .config/btop/btop.conf"
	"mpv/mpv.conf .config/mpv/mpv.conf"
	"cava/config .config/cava/config"
	"superfile/config.toml .config/superfile/config.toml"
	"superfile/hotkeys.toml .config/superfile/hotkeys.toml"
	"superfile/superfile.desktop .local/share/applications/superfile.desktop"
	"gtk/gtk-3.0.css .config/gtk-3.0/gtk.css"
	"gtk/gtk-4.0.css .config/gtk-4.0/gtk.css"
	"starship/starship.toml .config/starship.toml"
	"zsh/zshrc .zshrc"
	"shell/pikadots.bash .config/pikadots/pikadots.bash"
	"shell/pikadots.fish .config/fish/conf.d/pikadots.fish fish"
	"shell/pikadots.nu .local/share/nushell/vendor/autoload/pikadots.nu nu"
	"plasma/pikadots.sh .config/plasma-workspace/env/pikadots.sh"
	"pikadots/pikadots .local/bin/pikadots"
	"pikadots/pikadots-backup .local/bin/pikadots-backup"
	"pikadots/pikadots-meetings .local/bin/pikadots-meetings"
	"pikadots/pywalfox-host .local/bin/pywalfox-host"
	"pikadots/cmatrix .local/bin/cmatrix"
	"pikadots/pikadots-backup.service .config/systemd/user/pikadots-backup.service"
	"pikadots/pikadots-backup.timer .config/systemd/user/pikadots-backup.timer"
	"pikadots/pikadots-idle.service .config/systemd/user/pikadots-idle.service"
	"pikadots/pikadots-settings.desktop .local/share/applications/pikadots-settings.desktop"
)
services=(gcr-ssh-agent.socket)
session_services=(pikadots-idle.service)
retired_services=(pikadots-wallpaper.service)
system_services=(NetworkManager.service bluetooth.service power-profiles-daemon.service)
other_notifiers=(mako.service dunst.service swaync.service)
keep_packages=(networkmanager networkmanager-openvpn bluez bluez-utils pipewire-pulse wireplumber
	upower power-profiles-daemon zsh git neovim xdg-utils xdg-user-dirs gnome-keyring libsecret
	restic asusctl tuned tuned-ppd NetworkManager NetworkManager-openvpn pipewire-pulseaudio gcr curl unzip xz python3-pip)
pm=$pikadots_pm
extras_dir=$HOME/.local/share/fonts/pikadots
[[ :$PATH: == *":$HOME/.local/bin:"* ]] || export PATH=$HOME/.local/bin:$PATH

if [[ -t 1 ]]; then
	bold=$'\e[1m' dim=$'\e[2m' red=$'\e[31m' green=$'\e[32m' yellow=$'\e[33m' blue=$'\e[34m' reset=$'\e[0m'
else
	bold= dim= red= green= yellow= blue= reset=
fi
trap 'printf "\n%sinterrupted%s\n" "$yellow" "$reset" >&2; exit 130' INT
problems=0
step() { printf '\n%s%s::%s %s%s\n' "$bold" "$blue" "$reset$bold" "$*" "$reset"; }
ok() { printf '  %s✓%s %s\n' "$green" "$reset" "$*"; }
warn() { printf '  %s!%s %s\n' "$yellow" "$reset" "$*"; }
bad() { printf '  %s✗%s %s\n' "$red" "$reset" "$*"; problems=$((problems + 1)); }
info() { printf '  %s%s%s\n' "$dim" "$*" "$reset"; }
die() { printf '%serror:%s %s\n' "$red" "$reset" "$*" >&2; exit 1; }
confirm() {
	local answer
	read -rp "  $1 [y/N] " answer
	[[ $answer == [yY]* ]]
}

system_units() {
	local s
	for s in "${system_services[@]}"; do
		[[ $s == power-profiles-daemon.service ]] && rpm -q --quiet tuned-ppd 2>/dev/null && s=tuned-ppd.service
		echo "$s"
	done
}

linked() {
	[[ -L $HOME/$2 && $(readlink -f "$HOME/$2") == "$(readlink -f "$pkgdir/$1")" ]]
}

link_wanted() {
	[[ -e $pkgdir/$1 ]] && { [[ -z ${2:-} ]] || has "$2"; }
}

list() { grep -vE '^\s*(#|$)' "$repo/$1" 2>/dev/null; }

is_asus() { grep -qi asus /sys/class/dmi/id/sys_vendor 2>/dev/null; }

package_list() {
	case $pm in
	dnf) echo packages-fedora.txt ;;
	*) echo packages.txt ;;
	esac
}

side_package_list() {
	case $pm in
	pacman) list aur.txt ;;
	esac
}

wanted_packages() {
	list "$(package_list)"
	is_asus && echo asusctl
}

not_installed() {
	case $pm in
	pacman) xargs -r pacman -T 2>/dev/null ;;
	dnf) xargs -r rpm -q --whatprovides 2>/dev/null | sed -n 's/^no package provides //p' ;;
	esac
}

only_installed() {
	case $pm in
	pacman) xargs -r pacman -Qq 2>/dev/null ;;
	dnf) xargs -r rpm -q --qf '%{NAME}\n' 2>/dev/null | grep -v ' ' ;;
	esac
}

missing_packages() { wanted_packages | not_installed; }

prepare_repos() {
	case $pm in
	dnf) enable_coprs ;;
	esac
}

install_side_packages() {
	case $pm in
	dnf) install_extras ;;
	pacman) install_aur ;;
	esac
}

check_side_packages() {
	local extra aur
	case $pm in
	dnf)
		for extra in $(missing_extras); do
			warn "not installed: $extra (run repair)"
		done
		;;
	pacman)
		aur=$(list aur.txt | not_installed)
		[[ -z $aur ]] || warn "AUR packages missing: $(echo $aur)"
		;;
	esac
}

remove_side_packages() {
	case $pm in
	dnf) remove_extras ;;
	esac
}

removable_among() {
	local p
	case $pm in
	dnf)
		for p in $1; do
			dnf -q repoquery --installed --whatrequires "$p" --qf '%{name}\n' 2>/dev/null |
				grep -vxF -f <(printf '%s\n' $1) | grep -q . || echo "$p"
		done
		;;
	pacman)
		LC_ALL=C pacman -Qi $1 2>/dev/null | awk -v list="$(echo $1)" '
			BEGIN { n = split(list, a, " "); for (i = 1; i <= n; i++) want[a[i]] = 1 }
			/^Name/ { name = $3; ok = 1; inreq = 0 }
			/^Required By/ { inreq = 1; sub(/^Required By *: */, "") }
			/^[A-Z][a-zA-Z ]*:/ && !/^Required By/ { if (inreq) { if (ok) print name; inreq = 0 } }
			inreq { for (i = 1; i <= NF; i++) if ($i != "None" && !($i in want)) ok = 0 }
		'
		;;
	esac
}

record_installed() {
	mkdir -p "$state"
	printf '%s\n' "$@" | cat - "$state/installed-packages" 2>/dev/null | sort -u >"$state/installed-packages.tmp"
	mv "$state/installed-packages.tmp" "$state/installed-packages"
}

removable_packages() {
	local candidates
	if [[ -s $state/installed-packages ]]; then
		candidates=$(cat "$state/installed-packages")
	else
		candidates=$(list "$(package_list)"; side_package_list)
	fi
	candidates=$(printf '%s\n' $candidates | grep -vxF -f <(printf '%s\n' "${keep_packages[@]}") | only_installed)
	[[ -z $candidates ]] && return
	removable_among "$candidates"
}

remove_packages() {
	local pkgs list_file
	pkgs=$(removable_packages)
	if [[ -z $pkgs ]]; then
		info "no packages to remove"
		return
	fi
	if [[ -s $state/installed-packages ]]; then
		info "packages pikadots installed (essentials like networkmanager, zsh, git are never listed):"
	else
		info "pikadots didn't record what it installed, so these are from packages.txt; some may have"
		info "been installed before pikadots (essentials like networkmanager, zsh, git are never listed):"
	fi
	printf '%s\n' $pkgs | column -c "${COLUMNS:-100}" | sed 's/^/    /'
	[[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] &&
		warn "you're in Hyprland: removing hyprland and quickshell ends this session on next login"
	local answer
	read -rp "  Remove them? [y]es / [e]dit the list / [N]o " answer
	case $answer in
	[yY]*) ;;
	[eE]*)
		list_file=$(mktemp --suffix=.txt)
		{
			echo "# Delete the lines of packages to keep, then save and quit. # lines are ignored."
			printf '%s\n' $pkgs
		} >"$list_file"
		${EDITOR:-nvim} "$list_file" </dev/tty
		pkgs=$(grep -vE '^\s*(#|$)' "$list_file" | grep -xF -f <(printf '%s\n' $pkgs))
		rm -f "$list_file"
		[[ -z $pkgs ]] && { info "nothing selected"; return; }
		info "removing: $(echo $pkgs)"
		;;
	*) info "packages kept"; return ;;
	esac
	if pkg_remove $pkgs; then
		ok "removed $(echo $pkgs | wc -w) package(s)"
		[[ -f $state/installed-packages ]] &&
			grep -vxF -f <(printf '%s\n' $pkgs) "$state/installed-packages" >"$state/installed-packages.tmp" &&
			mv "$state/installed-packages.tmp" "$state/installed-packages"
	else
		bad "$pm didn't remove them"
	fi
}

coprs() {
	list copr.txt
	is_asus && echo lukenukem/asus-linux
}

enable_coprs() {
	local c repos=()
	for c in $(coprs); do
		compgen -G "/etc/yum.repos.d/_copr*:${c%/*}:${c#*/}.repo" >/dev/null || repos+=("$c")
	done
	((${#repos[@]})) || return 0
	if ! dnf copr --help >/dev/null 2>&1; then
		sudo dnf install -y dnf5-plugins >/dev/null || die "couldn't install dnf5-plugins (needed for COPR)"
	fi
	for c in "${repos[@]}"; do
		sudo dnf copr enable -y "$c" >/dev/null 2>&1 && ok "COPR $c" || die "couldn't enable COPR $c"
	done
}

matugen_4() {
	local v
	v=$(matugen --version 2>/dev/null) || return 1
	v=${v#matugen }
	((${v%%.*} >= 4))
}

extras=(
	"matugen|matugen_4|fetch_matugen|.local/bin/matugen"
	"firacode-nerd-font|fc-list -q 'FiraCode Nerd Font'|fetch_firacode|.local/share/fonts/pikadots"
	"fira-sans|fc-list -q 'Fira Sans'|fetch_fira_sans|.local/share/fonts/pikadots"
	"material-symbols|fc-list -q 'Material Symbols Rounded'|fetch_material_symbols|.local/share/fonts/pikadots"
	"superfile|has spf|fetch_superfile|.local/bin/spf"
	"papirus-folders|has papirus-folders|fetch_papirus_folders|.local/bin/papirus-folders"
	"pywalfox|has pywalfox|pip_install|"
	"recurring-ical-events|python3 -c 'import recurring_ical_events'|pip_install|"
)

extra_field() {
	local row name rest
	for row in "${extras[@]}"; do
		name=${row%%|*}
		[[ $name == "$1" ]] || continue
		rest=${row#*|}
		case $2 in
		check) echo "${rest%%|*}" ;;
		install) rest=${rest#*|}; echo "${rest%%|*}" ;;
		path) echo "${rest##*|}" ;;
		esac
		return 0
	done
	return 1
}

missing_extras() {
	local row
	for row in "${extras[@]}"; do
		eval "$(extra_field "${row%%|*}" check)" >/dev/null 2>&1 || echo "${row%%|*}"
	done
}

fetch() { curl -fsSL --retry 2 -o "$2" "$1"; }

latest_tag() {
	local tag
	tag=$(curl -fsSIL -o /dev/null -w '%{url_effective}' "https://github.com/$1/releases/latest") || return 1
	echo "${tag##*/}"
}

pip_user_list() { python3 -m pip list --user --format=freeze 2>/dev/null | sed 's/==.*//' | sort; }

fetch_matugen() {
	local tmp=$1 tag
	tag=$(latest_tag InioX/matugen) || return 1
	fetch "https://github.com/InioX/matugen/releases/download/$tag/matugen-${tag#v}-$(uname -m).tar.gz" "$tmp/matugen.tar.gz" &&
		tar -xzf "$tmp/matugen.tar.gz" -C "$tmp" matugen &&
		install -m755 "$tmp/matugen" "$HOME/.local/bin/matugen"
}

fetch_firacode() {
	fetch https://github.com/ryanoasis/nerd-fonts/releases/latest/download/FiraCode.tar.xz "$1/firacode.tar.xz" &&
		tar -xJf "$1/firacode.tar.xz" -C "$extras_dir" --wildcards 'FiraCodeNerdFont-*.ttf'
}

fetch_fira_sans() {
	local weight
	for weight in Light LightItalic Regular Italic Medium MediumItalic SemiBold SemiBoldItalic Bold BoldItalic; do
		fetch "https://github.com/google/fonts/raw/main/ofl/firasans/FiraSans-$weight.ttf" "$extras_dir/FiraSans-$weight.ttf" || return 1
	done
}

fetch_material_symbols() {
	local style
	for style in Outlined Rounded Sharp; do
		fetch "https://github.com/google/material-design-icons/raw/master/variablefont/MaterialSymbols$style%5BFILL,GRAD,opsz,wght%5D.ttf" \
			"$extras_dir/MaterialSymbols$style[FILL,GRAD,opsz,wght].ttf" || return 1
	done
}

fetch_superfile() {
	local tmp=$1 tag arch
	case $(uname -m) in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) return 1 ;; esac
	tag=$(latest_tag yorukot/superfile) || return 1
	fetch "https://github.com/yorukot/superfile/releases/download/$tag/superfile-linux-$tag-$arch.tar.gz" "$tmp/spf.tar.gz" &&
		tar -xzf "$tmp/spf.tar.gz" -C "$tmp" 2>/dev/null &&
		install -m755 "$(find "$tmp" -type f -name spf | head -1)" "$HOME/.local/bin/spf"
}

fetch_papirus_folders() {
	fetch https://raw.githubusercontent.com/PapirusDevelopmentTeam/papirus-folders/master/papirus-folders "$HOME/.local/bin/papirus-folders" &&
		chmod +x "$HOME/.local/bin/papirus-folders"
}

pip_install() {
	local before
	before=$(pip_user_list)
	python3 -m pip install --user --quiet --disable-pip-version-check "$2" || return 1
	comm -13 <(echo "$before") <(pip_user_list) >>"$state/pip-installed"
}

install_extra() {
	local recipe
	recipe=$(extra_field "$2" install) || return 1
	"$recipe" "$1" "$2"
}

install_extras() {
	local need tmp extra
	need=$(missing_extras)
	if [[ -n $need ]]; then
		info "not packaged for Fedora, downloading: $(echo $need)"
		tmp=$(mktemp -d)
		mkdir -p "$extras_dir" "$HOME/.local/bin" "$state"
		for extra in $need; do
			if install_extra "$tmp" "$extra"; then
				ok "$extra"
				grep -qsx "$extra" "$state/installed-extras" || echo "$extra" >>"$state/installed-extras"
			else
				warn "couldn't install $extra"
			fi
		done
		rm -rf "$tmp"
		fc-cache -f "$extras_dir" >/dev/null 2>&1
	fi
	ok "fonts and tools from outside Fedora installed"
	has wl-clip-persist || info "wl-clip-persist isn't packaged for Fedora; copied text goes away when its app closes"
}

remove_extras() {
	[[ -s $state/installed-extras ]] || return 0
	info "downloaded by pikadots: $(echo $(cat "$state/installed-extras"))"
	confirm "Remove them?" || { info "kept"; return; }
	local extra path
	while read -r extra; do
		path=$(extra_field "$extra" path) || continue
		[[ -n $path ]] && rm -rf "${HOME:?}/$path"
	done <"$state/installed-extras"
	[[ -s $state/pip-installed ]] &&
		python3 -m pip uninstall -y --quiet $(sort -u "$state/pip-installed") >/dev/null 2>&1
	rm -f "$state/pip-installed"
	fc-cache -f >/dev/null 2>&1
	rm -f "$state/installed-extras"
	ok "removed the downloaded fonts and tools"
}

install_packages() {
	[[ -n $pm ]] || die "pikadots needs Arch Linux (pacman) or Fedora (dnf)"
	prepare_repos
	local missing
	missing=$(missing_packages)
	if [[ -n $missing ]]; then
		info "installing: $(echo $missing)"
		pkg_install $missing || die "$pm failed"
		record_installed $missing
	fi
	ok "packages installed"
	install_side_packages
}

install_aur() {
	local aur helper
	aur=$(list aur.txt | not_installed)
	if [[ -n $aur ]]; then
		if helper=$(aur_helper); then
			if "$helper" -S --needed $aur; then
				ok "AUR packages installed"
				record_installed $aur
			else
				warn "AUR install failed: $(echo $aur)"
			fi
		else
			warn "no AUR helper (yay/paru); skipped: $(echo $aur)"
		fi
	fi
}

link_packages() {
	local backup="$backups/$(date +%Y%m%d-%H%M%S)" moved=0 entry src dst needs
	for entry in "${links[@]}"; do
		read -r src dst needs <<<"$entry"
		link_wanted "$src" "$needs" || continue
		if linked "$src" "$dst"; then
			ok "$dst"
			continue
		fi
		if [[ -e $HOME/$dst && ! -L $HOME/$dst ]]; then
			mkdir -p "$backup/$(dirname "$dst")"
			mv "$HOME/$dst" "$backup/$dst" && moved=$((moved + 1))
		fi
		local part=$HOME rest=$(dirname "$dst")
		while [[ $rest != . ]]; do
			part=$part/${rest%%/*}
			[[ -L $part && ! -e $part ]] && rm "$part"
			[[ $rest == */* ]] && rest=${rest#*/} || rest=.
		done
		mkdir -p "$(dirname "$HOME/$dst")"
		if ln -sfnr "$pkgdir/$src" "$HOME/$dst"; then
			ok "linked $dst"
		else
			bad "couldn't link $dst"
		fi
	done
	((moved > 0)) && info "moved $moved existing file(s) to ${backup/#$HOME/\~}"
	return 0
}

enable_services() {
	local s
	for s in $(system_units); do
		systemctl is-enabled -q "$s" 2>/dev/null && continue
		sudo systemctl enable --now "$s" >/dev/null 2>&1 && ok "$s" || bad "couldn't enable $s"
	done
	for s in "${retired_services[@]}"; do
		[[ -L $HOME/.config/systemd/user/$s ]] || continue
		systemctl --user disable --now "$s" >/dev/null 2>&1
		rm -f "$HOME/.config/systemd/user/$s" && ok "removed retired $s"
	done
	systemctl --user daemon-reload
	for s in "${other_notifiers[@]}"; do
		systemctl --user cat "$s" >/dev/null 2>&1 || continue
		[[ $(systemctl --user is-enabled "$s" 2>/dev/null) == masked ]] && continue
		if systemctl --user mask --now "$s" >/dev/null 2>&1; then
			ok "masked $s (Quickshell shows notifications)"
			remember masked-notifiers "$s"
		fi
	done
	for s in "${services[@]}"; do
		systemctl --user enable --now "$s" >/dev/null 2>&1 && ok "$s" || bad "couldn't enable $s"
	done
	for s in "${session_services[@]}"; do
		systemctl --user enable "$s" >/dev/null 2>&1 && ok "$s (starts with Hyprland)" || bad "couldn't enable $s"
	done
	if [[ -f $HOME/.config/restic/password ]]; then
		systemctl --user enable --now pikadots-backup.timer >/dev/null 2>&1 && ok "daily backup timer"
	else
		info "backups not set up yet (pikadots backup-init)"
	fi
}

remember() {
	mkdir -p "$state"
	grep -qsxF -- "$2" "$state/$1" || printf '%s\n' "$2" >>"$state/$1"
}

unmask_notifiers() {
	local s
	[[ -s $state/masked-notifiers ]] || return 0
	while read -r s; do
		[[ $(systemctl --user is-enabled "$s" 2>/dev/null) == masked ]] || continue
		systemctl --user unmask "$s" >/dev/null 2>&1 && ok "unmasked $s"
	done <"$state/masked-notifiers"
	rm -f "$state/masked-notifiers"
}

pywalfox_manifests=("$HOME/.mozilla/native-messaging-hosts/pywalfox.json"
	"$HOME/.config/mozilla/native-messaging-hosts/pywalfox.json")

remove_pywalfox() {
	local m
	for m in "${pywalfox_manifests[@]}"; do
		grep -qs pywalfox-host "$m" && rm -f "$m" && ok "removed the Pywalfox helper ${m/#$HOME/\~}"
	done
	return 0
}

setup_pywalfox() {
	has pywalfox || return 0
	local m
	for m in "${pywalfox_manifests[@]}"; do
		mkdir -p "${m%/*}"
		cat >"$m" <<-EOF
			{
			  "name": "pywalfox",
			  "description": "Pywalfox helper, one socket per browser (pikadots)",
			  "path": "$HOME/.local/bin/pywalfox-host",
			  "type": "stdio",
			  "allowed_extensions": ["pywalfox@frewacom.org"]
			}
		EOF
	done
	ok "Pywalfox helper for Zen and Firefox (add the Pywalfox extension in each)"
}

set_default_app() {
	xdg-mime default "$1" "$2" && remember default-apps "$2 $1"
}

setup_default_apps() {
	local list="$HOME/.config/xdg-terminals.list" folders
	if [[ ! -s $list ]]; then
		echo kitty.desktop >"$list"
		remember default-apps "terminal kitty.desktop"
	fi
	folders=$(xdg-mime query default inode/directory 2>/dev/null)
	if [[ -z $folders || $folders == kitty-open.desktop ]]; then
		if has spf; then
			set_default_app superfile.desktop inode/directory
		elif [[ -f /usr/share/applications/thunar.desktop ]]; then
			set_default_app thunar.desktop inode/directory
		fi
	fi
	[[ -n $(xdg-mime query default text/plain 2>/dev/null) ]] || set_default_app nvim.desktop text/plain
	ok "default apps: terminal $(head -1 "$list"), browser $(xdg-settings get default-web-browser 2>/dev/null || echo none), files $(xdg-mime query default inode/directory), editor $(xdg-mime query default text/plain)"
}

undo_default_apps() {
	local kind app mimeapps=$HOME/.config/mimeapps.list list=$HOME/.config/xdg-terminals.list
	[[ -s $state/default-apps ]] || return 0
	while read -r kind app; do
		if [[ $kind == terminal ]]; then
			[[ $(cat "$list" 2>/dev/null) == "$app" ]] && rm -f "$list" && ok "removed ${list/#$HOME/\~}"
		elif [[ $(xdg-mime query default "$kind" 2>/dev/null) == "$app" && -f $mimeapps ]]; then
			sed -i --follow-symlinks "\\|^$kind=$app;\\?\$|d" "$mimeapps" && ok "default app for $kind unset ($app)"
		fi
	done <"$state/default-apps"
	rm -f "$state/default-apps"
}

mozilla_profiles() {
	local ini dir profile
	for ini; do
		[[ -f $ini ]] || continue
		dir=${ini%/*}
		while IFS= read -r profile; do
			[[ -f $dir/$profile/prefs.js ]] && printf '%s\n' "$dir/$profile"
		done < <(sed -n 's/^Path=//p' "$ini")
	done
}

zen_profiles() { mozilla_profiles "$HOME/.config/zen/profiles.ini" "$HOME/.zen/profiles.ini"; }
thunderbird_profiles() { mozilla_profiles "$HOME/.config/thunderbird/profiles.ini" "$HOME/.thunderbird/profiles.ini"; }

theme_profile() {
	local dir=$1 line=$2 css js pref key
	shift 2
	css=$dir/chrome/userChrome.css js=$dir/user.js
	mkdir -p "${css%/*}"
	if ! grep -qsF "$line" "$css"; then
		{ echo "$line"; cat "$css" 2>/dev/null || true; } >"$css.tmp" && mv "$css.tmp" "$css"
	fi
	for pref; do
		key=${pref%%=*}
		grep -qsF "$key" "$js" && continue
		pref="user_pref(\"$key\", ${pref#*=});"
		echo "$pref" >>"$js"
		remember mozilla-prefs "$js	$pref"
	done
}

untheme_profile() {
	local dir=$1 line=$2 css=$1/chrome/userChrome.css
	if grep -qsxF "$line" "$css"; then
		grep -vxF "$line" "$css" >"$css.tmp" && mv "$css.tmp" "$css"
		[[ -s $css ]] || rm -f "$css"
		ok "${dir##*/}: wallpaper colors removed from userChrome.css"
	fi
}

undo_mozilla_prefs() {
	local js pref
	[[ -s $state/mozilla-prefs ]] || return 0
	while IFS=$'\t' read -r js pref; do
		[[ -f $js ]] || continue
		grep -vxF "$pref" "$js" >"$js.tmp" && mv "$js.tmp" "$js"
		[[ -s $js ]] || rm -f "$js"
	done <"$state/mozilla-prefs"
	rm -f "$state/mozilla-prefs"
	ok "removed the user.js prefs pikadots added"
}

zen_line="@import url(\"file://$HOME/.local/state/theme/zen-userChrome.css\");"
thunderbird_line="@import url(\"file://$HOME/.local/state/theme/thunderbird-userChrome.css\");"

setup_zen() {
	local dir
	while IFS= read -r dir; do
		theme_profile "$dir" "$zen_line" \
			toolkit.legacyUserProfileCustomizations.stylesheets=true \
			zen.theme.disable-lightweight=false \
			zen.widget.linux.transparency=true \
			browser.tabs.allow_transparent_browser=true
		ok "Zen profile ${dir##*/} uses the wallpaper colors (after Zen restarts)"
	done < <(zen_profiles)
	return 0
}

setup_mpv() {
	has mpv || return 0
	mkdir -p "$state"
	[[ -e $state/mpv-font.conf ]] || : >"$state/mpv-font.conf"
	ok "mpv follows the wallpaper colors and the shell font"
}

setup_thunderbird() {
	local dir
	while IFS= read -r dir; do
		theme_profile "$dir" "$thunderbird_line" toolkit.legacyUserProfileCustomizations.stylesheets=true
		ok "Thunderbird profile ${dir##*/} uses the wallpaper colors (after Thunderbird restarts)"
	done < <(thunderbird_profiles)
	return 0
}

untheme_mozilla() {
	local dir
	while IFS= read -r dir; do untheme_profile "$dir" "$zen_line"; done < <(zen_profiles)
	while IFS= read -r dir; do untheme_profile "$dir" "$thunderbird_line"; done < <(thunderbird_profiles)
	undo_mozilla_prefs
}

setup_vscode() {
	has code-oss || has code || has codium || return 0
	local out line
	if out=$(python3 -I "$pkgdir/hypr/scripts/vscode-theme.py" install 2>&1); then
		while IFS= read -r line; do
			[[ -n $line ]] && ok "$line (live)"
		done <<<"$out"
	else
		warn "VS Code theme: ${out//$'\n'/; }"
	fi
	return 0
}

git_identity() {
	[[ -f $HOME/.config/git/user ]] && return
	local name email
	printf '  Your name and email for git commits (kept out of the repo):\n'
	read -rp "    Name:  " name
	read -rp "    Email: " email
	[[ -n $name && -n $email ]] || { warn "skipped; add them to ~/.config/git/user later"; return; }
	printf '[user]\n\tname = %s\n\temail = %s\n' "$name" "$email" >"$HOME/.config/git/user"
	ok "git identity saved"
}

login_shell() { basename "$(getent passwd "$USER" | cut -d: -f7)"; }

bash_line='[[ -f ~/.config/pikadots/pikadots.bash ]] && . ~/.config/pikadots/pikadots.bash'
nu_autoload=$HOME/.local/share/nushell/vendor/autoload

shell_ready() {
	case $1 in
	zsh) linked zsh/zshrc .zshrc ;;
	bash) grep -qsxF "$bash_line" "$HOME/.bashrc" && linked shell/pikadots.bash .config/pikadots/pikadots.bash ;;
	fish) linked shell/pikadots.fish .config/fish/conf.d/pikadots.fish ;;
	nu) linked shell/pikadots.nu .local/share/nushell/vendor/autoload/pikadots.nu ;;
	esac
}

setup_shells() {
	grep -qsxF "$bash_line" "$HOME/.bashrc" || printf '\n%s\n' "$bash_line" >>"$HOME/.bashrc"
	if has nu; then
		mkdir -p "$nu_autoload"
		has starship && starship init nu >"$nu_autoload/pikadots-starship.nu"
		has zoxide && zoxide init nushell --cmd cd >"$nu_autoload/pikadots-zoxide.nu"
		has mise && mise activate nu >"$nu_autoload/pikadots-mise.nu"
	fi
	local shell
	shell=$(login_shell)
	case $shell in
	bash | zsh | fish | nu) ok "prompt, colors and aliases set up for $shell (your login shell)" ;;
	*) info "your login shell is $shell; pikadots sets up bash, zsh, fish and nushell, so $shell is left alone" ;;
	esac
}

remove_shells() {
	[[ -f $HOME/.bashrc ]] && grep -vxF "$bash_line" "$HOME/.bashrc" >"$HOME/.bashrc.tmp" && mv "$HOME/.bashrc.tmp" "$HOME/.bashrc"
	rm -f "$nu_autoload"/pikadots-{starship,zoxide,mise}.nu
	ok "shell setup removed (bash, fish, nushell)"
}

wallpaper() {
	local img
	img=$(wallpaper_path)
	[[ -f $img ]] && { echo "$img"; return; }
	find "$HOME/Pictures/Wallpapers" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.png' -o -iname '*.webp' \) 2>/dev/null | head -1
}

copy_wallpapers() {
	local dir=$HOME/Pictures/Wallpapers n=0 f
	mkdir -p "$dir"
	for f in "$repo"/wallpapers/*.{jpg,jpeg,png,webp}; do
		[[ -f $f ]] || continue
		[[ -e $dir/${f##*/} ]] || { cp "$f" "$dir/" && n=$((n + 1)); }
	done
	((n)) && ok "$n wallpapers in ~/Pictures/Wallpapers"
	return 0
}

generate_colors() {
	local img
	img=$(wallpaper)
	if [[ -z $img ]]; then
		warn "no wallpaper found; put images in ~/Pictures/Wallpapers, then run: ~/.config/hypr/scripts/theme.sh <image>"
		return
	fi
	"$HOME/.config/hypr/scripts/theme.sh" "$img" >/dev/null 2>&1 && ok "colors from ${img/#$HOME/\~}" || bad "theme.sh failed"
}

reload_desktop() {
	[[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || return 0
	hyprctl reload >/dev/null && ok "Hyprland reloaded"
	kill_shell
	hyprctl dispatch 'hl.dsp.exec_cmd("~/.config/hypr/scripts/shell.sh")' >/dev/null && ok "Quickshell restarted"
}

setup_all() {
	step "Packages"
	install_packages
	step "Links"
	link_packages
	[[ $1 == install ]] && git_identity
	setup_shells
	step "Services"
	enable_services
	greeter_refresh
	setup_pywalfox
	setup_zen
	setup_thunderbird
	setup_mpv
	setup_vscode
	setup_default_apps
	step "Colors"
	if [[ $1 == install ]]; then
		mkdir -p "$HOME/.local/state/quickshell" "$HOME/Pictures/Screenshots" "$HOME/Videos/Recordings"
		copy_wallpapers
	fi
	generate_colors
}

cmd_install() {
	printf '%spikadots install%s  (%s)\n' "$bold" "$reset" "${repo/#$HOME/\~}"
	setup_all install
	mkdir -p "$state" && date +%s >"$state/installed"
	step "Done"
	if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
		reload_desktop
	else
		info "log out and pick the Hyprland session"
	fi
	info "set up displays from the monitor icon in the bar, VPNs from the network panel"
	info "optional: pikadots backup-init · gh auth login · pikadots health"
}

cmd_uninstall() {
	printf '%spikadots uninstall%s\n' "$bold" "$reset"
	info "removes the links into ~ and restores files pikadots backed up; then offers to remove packages"
	confirm "Continue?" || exit 0
	step "Services"
	systemctl --user disable --now pikadots-backup.timer >/dev/null 2>&1 && ok "backup timer stopped"
	systemctl --user disable "${session_services[@]}" >/dev/null 2>&1 && ok "idle service disabled"
	python3 -I "$pkgdir/hypr/scripts/kde-theme.py" restore >/dev/null 2>&1 &&
		ok "Qt/KDE theme restored"
	python3 -I "$pkgdir/hypr/scripts/vscode-theme.py" restore >/dev/null 2>&1 &&
		ok "VS Code theme restored"
	unmask_notifiers
	step "Apps"
	remove_pywalfox
	untheme_mozilla
	undo_default_apps
	if [[ -e $plm_theme_conf || -d $plm_theme_dir ]]; then
		step "Login screen"
		(plm_theme_reset)
	fi
	if [[ -d $qs_greeter_share || -d $qs_greeter_state ]]; then
		step "Pikadots greeter"
		(greeter_remove)
	fi
	if [[ -d $splash_dir ]]; then
		step "Boot splash"
		(cmd_splash --reset)
	fi
	local keep_cli=
	[[ -d $qs_greeter_share ]] && keep_cli=.local/bin/pikadots
	step "Links"
	local entry src dst
	for entry in "${links[@]}"; do
		read -r src dst _ <<<"$entry"
		[[ $dst == "$keep_cli" ]] && continue
		linked "$src" "$dst" || continue
		rm "$HOME/$dst" && ok "unlinked $dst" || bad "couldn't unlink $dst"
	done
	remove_shells
	if [[ -n $keep_cli ]]; then
		warn "kept ~/$keep_cli, so 'pikadots greeter remove' still works (also from a text console)"
		info "it runs from ${repo/#$HOME/\~}, so keep that folder until then; afterwards: rm ~/$keep_cli"
	fi
	step "Restore"
	local first
	first=$(ls -1d "$backups"/*/ 2>/dev/null | head -1)
	if [[ -n $first ]]; then
		cp -an "$first". "$HOME"/ && ok "restored files from ${first/#$HOME/\~}"
	else
		info "nothing was backed up"
	fi
	rm -f "$state/installed"
	step "Packages (optional)"
	remove_packages
	remove_side_packages
	step "Done"
	info "your backups, keyring and git identity are untouched"
	info "a terminal opened before this update may show 'No such file' errors; open a new one"
}

cmd_health() {
	printf '%spikadots health%s\n' "$bold" "$reset"

	step "Packages"
	local missing
	missing=$(missing_packages)
	[[ -z $missing ]] && ok "all $(wanted_packages | wc -l) packages installed" || bad "missing: $(echo $missing)"
	check_side_packages

	step "Links"
	local entry src dst needs
	for entry in "${links[@]}"; do
		read -r src dst needs <<<"$entry"
		link_wanted "$src" "$needs" || continue
		linked "$src" "$dst" && ok "~/$dst" || bad "~/$dst isn't linked"
	done
	local shell
	shell=$(login_shell)
	case $shell in
	bash | zsh | fish | nu)
		if shell_ready "$shell"; then
			ok "$shell (your login shell) has the prompt, colors and aliases"
		elif [[ $shell != zsh ]]; then
			bad "$shell (your login shell) isn't set up (run repair)"
		fi
		;;
	*) info "login shell $shell isn't one pikadots sets up (bash, zsh, fish, nushell)" ;;
	esac

	step "Services"
	local s
	for s in $(system_units); do
		systemctl is-active -q "$s" && ok "$s" || bad "$s not running"
	done
	for s in "${services[@]}"; do
		systemctl --user is-active -q "$s" && ok "$s" || bad "$s not running"
	done
	for s in "${session_services[@]}"; do
		if ! systemctl --user is-enabled -q "$s" 2>/dev/null; then
			warn "$s not enabled (pikadots repair)"
		elif [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && ! systemctl --user is-active -q "$s"; then
			bad "$s not running (journalctl --user -u $s)"
		else
			ok "$s"
		fi
	done
	if systemctl --user is-enabled -q pikadots-backup.timer 2>/dev/null; then
		ok "backup timer (next: $(systemctl --user list-timers pikadots-backup.timer --no-legend | awk '{print $1, $2, $3}'))"
	else
		warn "daily backup not enabled (pikadots backup-init)"
	fi

	step "Desktop"
	if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
		local errors
		errors=$(hyprctl configerrors 2>/dev/null | grep -v '^\s*$')
		[[ -z $errors ]] && ok "Hyprland config loads without errors" || bad "Hyprland config errors: $errors"
		local notifier
		notifier=$(busctl --user status org.freedesktop.Notifications 2>/dev/null | sed -n 's/^Comm=//p')
		[[ $notifier == qs || $notifier == quickshell ]] && ok "Quickshell shows notifications" ||
			bad "notifications are handled by ${notifier:-nothing}, not Quickshell (run repair)"
		local instances
		instances=$(pgrep -u "$USER" -cx 'qs|quickshell')
		((instances > 1)) && bad "$instances Quickshell instances running (run repair)"
		if ((instances > 0)); then
			errors=$(qs log 2>/dev/null | awk '/Reloading configuration/ { buf = "" } /ERROR/ { buf = $0 } END { print buf }')
			[[ -z $errors ]] && ok "Quickshell running" || bad "Quickshell: $(sed 's/\x1b\[[0-9;]*m//g' <<<"$errors")"
		else
			bad "Quickshell isn't running"
		fi
	else
		info "not in a Hyprland session; skipped"
	fi
	[[ -f $HOME/.local/state/theme/quickshell.json ]] && ok "wallpaper colors generated" || bad "no wallpaper colors (run repair)"
	local settings=$HOME/.config/pikadots/settings.json
	if [[ ! -f $settings ]]; then
		ok "Settings app: defaults (nothing changed yet)"
	elif jq -e . "$settings" >/dev/null 2>&1; then
		ok "Settings app choices ($(jq '[.hypr // {} | keys[]] | length' "$settings") Hyprland option(s) changed)"
	else
		bad "Settings app file is not valid JSON: ${settings/#$HOME/\~} (fix or delete it)"
	fi
	local frag=$pkgdir/quickshell/shaders/glass.frag
	if [[ ! -f $frag.qsb ]]; then
		bad "glass shader not built (run ~/.config/hypr/scripts/shaders.sh)"
	elif [[ $frag -nt $frag.qsb ]]; then
		warn "glass shader is older than its source (run ~/.config/hypr/scripts/shaders.sh)"
	else
		ok "glass shader built ($(jq -r '.glass.preset // "frosted"' "$settings" 2>/dev/null || echo frosted) preset)"
	fi
	pgrep -x hypridle >/dev/null && ok "hypridle running (idle timers)" || warn "hypridle isn't running (~/.config/hypr/scripts/idle.sh starts it)"
	if has pywalfox; then
		grep -qs pywalfox-host "${pywalfox_manifests[0]}" && ok "browser colors (Pywalfox helper)" ||
			bad "Pywalfox helper not set up for the browsers (run repair)"
	fi

	step "Developer"
	[[ -f $HOME/.config/git/user ]] && ok "git identity: $(git config --get user.name) <$(git config --get user.email)>" || bad "no git identity (~/.config/git/user)"
	busctl --user status org.freedesktop.secrets >/dev/null 2>&1 && ok "keyring (Secret Service) available" || warn "keyring not running yet (it starts on first use)"
	[[ -S ${XDG_RUNTIME_DIR:-/run/user/$UID}/gcr/ssh ]] && ok "SSH agent socket" || bad "no SSH agent socket"
	if has gh; then
		gh auth status >/dev/null 2>&1 && ok "GitHub CLI signed in" || warn "GitHub CLI not signed in (gh auth login)"
	fi
	[[ -f $HOME/.config/pikadots/calendar.url ]] && ok "calendar link set" || info "no calendar link (~/.config/pikadots/calendar.url)"
	if [[ -f $repo/docs/keybindings.md ]]; then
		local drift
		drift=$(cmd_docs_check --summary 2>/dev/null)
		if [[ $drift == "0 0" ]]; then
			ok "keybinding docs match keybinds.lua"
		elif [[ -n $drift ]]; then
			warn "keybinding docs: ${drift% *} bind(s) undocumented, ${drift#* } row(s) with unbound keys (pikadots docs-check)"
		fi
	fi

	step "Login and boot"
	check_greeter

	step "Snapshots"
	check_snapshots

	step "Backups"
	local status="$state/backup.json"
	if [[ -f $status ]]; then
		local time okv age
		time=$(jq -r .time "$status") okv=$(jq -r .ok "$status")
		age=$((($(date +%s) - time) / 3600))
		if [[ $okv == true ]]; then
			((age <= 48)) && ok "last backup ${age} h ago ($(jq -r .snapshots "$status") snapshots)" || bad "last backup ${age} h ago"
		else
			bad "last backup failed: $(jq -r .message "$status")"
		fi
	else
		warn "no backup yet"
	fi

	if is_asus && has asusctl; then
		step "Laptop"
		local limit
		limit=$(cat /sys/class/power_supply/BAT0/charge_control_end_threshold 2>/dev/null)
		[[ ${limit:-100} -lt 100 ]] && ok "battery charge limit ${limit}%" || warn "no battery charge limit (battery panel → Battery care)"
	fi

	printf '\n'
	if ((problems == 0)); then
		printf '%s%sAll good.%s\n' "$bold" "$green" "$reset"
	else
		printf '%s%s%d problem(s).%s Run %spikadots repair%s to fix them.\n' "$bold" "$red" "$problems" "$reset" "$bold" "$reset"
		exit 1
	fi
}

cmd_repair() {
	printf '%spikadots repair%s\n' "$bold" "$reset"
	setup_all repair
	step "Reload"
	reload_desktop
	printf '\nRun %spikadots health%s to check.\n' "$bold" "$reset"
}

cmd_update() {
	printf '%spikadots update%s\n' "$bold" "$reset"
	step "Repository"
	if git -C "$repo" remote get-url origin >/dev/null 2>&1; then
		local before
		before=$(git -C "$repo" rev-parse HEAD)
		git -C "$repo" pull --rebase --autostash --quiet || die "git pull failed; resolve it in $repo"
		if [[ $(git -C "$repo" rev-parse HEAD) == "$before" ]]; then
			ok "already up to date"
			info "nothing new, so no repair; run pikadots repair to check anyway"
			return
		fi
		ok "updated:"
		git -C "$repo" log --oneline "$before..HEAD" | sed 's/^/    /'
	else
		warn "no remote set; nothing to pull"
		return
	fi
	if snapper_root; then
		step "Snapshot"
		snapshot_before_update
	fi
	cmd_repair
	snapshot_after_update
}

cmd_backup_init() {
	printf '%spikadots backup-init%s\n' "$bold" "$reset"
	local config=$HOME/.config/pikadots/backup-repo repo_dir
	if [[ ! -f $config ]]; then
		read -rp "  Back up to (a cloud-synced folder keeps a copy off the machine) [~/Backups/restic]: " repo_dir
		mkdir -p "$(dirname "$config")"
		echo "${repo_dir:-~/Backups/restic}" >"$config"
	fi
	repo_dir=$(sed "s|^~|$HOME|" "$config")
	local password_file=$HOME/.config/restic/password
	mkdir -p "$(dirname "$password_file")" && chmod 700 "$(dirname "$password_file")"
	if [[ ! -f $password_file ]]; then
		head -c 33 /dev/urandom | base64 >"$password_file"
		chmod 600 "$password_file"
		ok "password created: ${password_file/#$HOME/\~}"
		warn "save a copy of it somewhere safe (password manager); without it the backup can't be read"
	fi
	if [[ -f $repo_dir/config ]]; then
		ok "repository exists: ${repo_dir/#$HOME/\~}"
	else
		mkdir -p "$(dirname "$repo_dir")"
		RESTIC_PASSWORD_FILE=$password_file restic init --repo "$repo_dir" >/dev/null && ok "repository created: ${repo_dir/#$HOME/\~}" || die "restic init failed"
	fi
	systemctl --user daemon-reload
	systemctl --user enable --now pikadots-backup.timer >/dev/null && ok "daily backup enabled"
	info "first backup: pikadots backup"
}

cmd_backup() {
	"$HOME/.local/bin/pikadots-backup" && ok "backed up ($(jq -r '.snapshots' "$state/backup.json") snapshots)"
}

settings_files=(.config/pikadots/settings.json .local/state/pikadots/hypr-settings.lua
	.local/state/pikadots/autostart.lua .local/state/pikadots/window-rules.lua)

cmd_export() {
	local out=${1:-$HOME/pikadots-settings-$(date +%F).tar.gz} tmp img f
	[[ -f $HOME/.config/pikadots/settings.json ]] || die "no settings yet (~/.config/pikadots/settings.json)"
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"; trap - RETURN' RETURN
	for f in "${settings_files[@]}" .face; do
		[[ -f $HOME/$f ]] || continue
		mkdir -p "$tmp/$(dirname "$f")"
		cp "$HOME/$f" "$tmp/$f"
	done
	img=$(wallpaper)
	if [[ -n $img ]]; then
		mkdir -p "$tmp/wallpaper"
		cp "$img" "$tmp/wallpaper/"
	fi
	jq -n --arg host "$(cat /etc/hostname 2>/dev/null)" --arg date "$(date -Iseconds)" \
		--arg wallpaper "${img##*/}" '{version: 1, host: $host, date: $date, wallpaper: $wallpaper}' >"$tmp/pikadots-export.json"
	tar -czf "$out" -C "$tmp" . || die "couldn't write $out"
	ok "saved ${out/#$HOME/\~} ($(du -h "$out" | cut -f1))"
	info "on the new machine, after install: pikadots import ${out##*/}"
}

cmd_import() {
	local file=${1:-} tmp backup f img
	[[ -f $file ]] || die "usage: pikadots import FILE (from pikadots export, or a settings.json)"
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"; trap - RETURN' RETURN
	if jq -e .appearance "$file" >/dev/null 2>&1; then
		mkdir -p "$tmp/.config/pikadots"
		cp "$file" "$tmp/.config/pikadots/settings.json"
	else
		tar -xzf "$file" -C "$tmp" 2>/dev/null || die "not a pikadots export: $file"
		jq -e .appearance "$tmp/.config/pikadots/settings.json" >/dev/null 2>&1 || die "no settings in $file"
	fi
	printf '%spikadots import%s\n' "$bold" "$reset"
	[[ -f $tmp/pikadots-export.json ]] && info "from $(jq -r '"\(.host) on \(.date[:10])"' "$tmp/pikadots-export.json")"

	step "Files"
	kill_shell
	backup=$backups/import-$(date +%Y%m%d-%H%M%S)
	for f in "${settings_files[@]}" .face; do
		[[ -f $tmp/$f ]] || continue
		if [[ -f $HOME/$f ]]; then
			mkdir -p "$backup/$(dirname "$f")"
			cp "$HOME/$f" "$backup/$f"
		fi
		mkdir -p "$HOME/$(dirname "$f")"
		cp "$tmp/$f" "$HOME/$f"
		ok "${f}"
	done
	[[ -d $backup ]] && info "previous files: ${backup/#$HOME/\~}"
	img=$(find "$tmp/wallpaper" -maxdepth 1 -type f 2>/dev/null | head -1)
	if [[ -n $img ]]; then
		mkdir -p "$HOME/Pictures/Wallpapers"
		[[ -e $HOME/Pictures/Wallpapers/${img##*/} ]] || cp "$img" "$HOME/Pictures/Wallpapers/"
		img=$HOME/Pictures/Wallpapers/${img##*/}
		wallpaper_save "$img"
		ok "wallpaper ${img/#$HOME/\~}"
	fi

	step "Apply"
	generate_colors
	if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
		local scripts=$HOME/.config/hypr/scripts s cmd
		for s in fonts.sh icons.sh accessibility.sh "clipboard.sh watch"; do
			read -ra cmd <<<"$s"
			"$scripts/${cmd[0]}" "${cmd[@]:1}" >/dev/null 2>&1 || warn "${cmd[0]} failed"
		done
		setsid -f "$scripts/idle.sh" >/dev/null 2>&1
		ok "fonts, icons, accessibility, clipboard, idle timers"
		reload_desktop
	else
		info "log in to Hyprland to see everything applied"
	fi
}

snapper_root() { has snapper && [[ -f /etc/snapper/configs/root ]]; }

check_snapshots() {
	if ! has snapper; then
		info "snapper not installed; skipped"
		return
	fi
	local json source count latest age
	json=$("$pkgdir/hypr/scripts/snapshots.sh" 2>/dev/null)
	if [[ $(jq -r '.config // false' <<<"$json" 2>/dev/null) != true ]]; then
		warn "snapper has no root config (sudo snapper -c root create-config /)"
		return
	fi
	pacman -Q snap-pac >/dev/null 2>&1 && ok "snapper root config, snap-pac snapshots every pacman run" || ok "snapper root config"
	source=$(jq -r .source <<<"$json")
	if [[ -z $source ]]; then
		info "listing snapshots needs root here, so their age isn't checked"
		return
	fi
	count=$(jq -r .count <<<"$json") latest=$(jq -r '.latest // 0' <<<"$json")
	[[ $source == grub-btrfs ]] && source=" in the boot menu" || source=""
	if ((count == 0)); then
		warn "no snapshots yet"
		return
	fi
	age=$(($(date +%s) - latest))
	if ((age >= 7 * 86400)); then
		warn "latest snapshot $((age / 86400)) days ago ($count$source)"
	elif ((age >= 48 * 3600)); then
		ok "latest snapshot $((age / 86400)) days ago ($count$source)"
	elif ((age >= 3600)); then
		ok "latest snapshot $((age / 3600)) h ago ($count$source)"
	else
		ok "latest snapshot $((age / 60)) min ago ($count$source)"
	fi
}

update_snapshot=
snapshot_before_update() {
	snapper_root || return 0
	if pacman -Q snap-pac >/dev/null 2>&1; then
		info "snap-pac snapshots the system around pacman, so no extra snapshot"
		return 0
	fi
	update_snapshot=$(sudo snapper -c root create --type pre --cleanup-algorithm number --print-number \
		--description "pikadots update") && ok "snapshot $update_snapshot taken (roll back with snapper or the boot menu)" ||
		{ update_snapshot=; warn "couldn't take a snapshot; updating anyway"; }
}

snapshot_after_update() {
	[[ -n $update_snapshot ]] || return 0
	sudo snapper -c root create --type post --pre-number "$update_snapshot" --cleanup-algorithm number \
		--description "pikadots update" >/dev/null && ok "snapshot after the update paired with $update_snapshot"
}

display_manager() {
	local unit
	unit=$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null)
	unit=${unit##*/}
	echo "${unit%.service}"
}

plm_theme_dir=/var/lib/pikadots/greeter
plm_theme_conf=/etc/plasmalogin.conf.d/pikadots.conf
plm_kdeglobals=/var/lib/plasmalogin/.config/kdeglobals

plm_theme_colors() {
	grep -qs '^PikadotsApplied=true' "$HOME/.config/kdeglobals" || return 1
	awk '
		/^\[/ { keep = /^\[(Colors|ColorEffects):/ || /^\[WM\]/; general = /^\[General\]/; if (keep) print; next }
		keep { print }
		general && /^(ColorScheme|AccentColor)=/ { extra = extra $0 "\n" }
		END { if (extra != "") printf "[General]\n%s", extra }
	' "$HOME/.config/kdeglobals"
}

check_greeter() {
	local dm img copy
	dm=$(display_manager)
	case $dm in
	plasmalogin)
		if [[ -f $plm_theme_conf ]]; then
			img=$(wallpaper)
			copy=$(find "$plm_theme_dir" -maxdepth 1 -name 'wallpaper.*' 2>/dev/null | head -1)
			if [[ -n $img && -n $copy ]] && ! cmp -s "$img" "$copy"; then
				warn "login screen shows an older wallpaper (pikadots greeter)"
			else
				ok "login screen uses the wallpaper and colors (Plasma Login Manager)"
			fi
		else
			info "login screen: Plasma Login Manager defaults (pikadots greeter themes it)"
		fi
		;;
	"") info "no display manager" ;;
	greetd)
		if [[ -f $qs_greeter_share/shell.qml ]]; then
			img=$(wallpaper)
			copy=$(find "$qs_greeter_state" -maxdepth 1 -name 'wallpaper.*' 2>/dev/null | head -1)
			if greeter_outdated; then
				bad "the installed pikadots greeter is outdated and may not log in (pikadots repair updates it)"
			elif [[ -n $img && -n $copy ]] && ! cmp -s "$img" "$copy"; then
				warn "login screen shows an older wallpaper (pikadots greeter)"
			else
				ok "login screen: the pikadots greeter (greetd)"
			fi
		else
			info "login screen: greetd (pikadots greeter install puts the pikadots greeter on it)"
		fi
		;;
	*) info "login screen: $dm (pikadots greeter install switches it to the pikadots greeter)" ;;
	esac
	if has plymouth-set-default-theme; then
		local theme
		theme=$(plymouth-set-default-theme 2>/dev/null)
		[[ $theme == pikadots ]] && ok "boot splash: pikadots" || info "boot splash: ${theme:-none} (pikadots splash themes it)"
	fi
}

qs_greeter_src=$pkgdir/greeter
qs_greeter_share=/usr/share/pikadots-greeter
qs_greeter_state=/var/lib/pikadots-greeter
greetd_conf=/etc/greetd/config.toml
greetd_dropin=/etc/systemd/system/greetd.service.d/pikadots.conf
greetd_pam=/etc/pam.d/greetd
qs_greeter_files=(shell.qml Greeter.qml GreeterTheme.qml LockSurface.qml LockButton.qml LockIcon.qml hyprland.lua)

greeter_env() {
	printf 'env PIKADOTS_GREETER_DIR=%s FONTCONFIG_FILE=%s/fonts.conf ' "$qs_greeter_state" "$qs_greeter_state"
}

greeter_command() {
	local log=
	has systemd-cat && log='systemd-cat -t pikadots-greeter '
	if has start-hyprland; then
		printf '%s%sstart-hyprland -- -c %s/hyprland.lua' "$(greeter_env)" "$log" "$qs_greeter_share"
	else
		printf '%s%sHyprland -c %s/hyprland.lua' "$(greeter_env)" "$log" "$qs_greeter_share"
	fi
}

greetd_user() {
	local u
	u=$(sed -n 's/^\s*user\s*=\s*"\(.*\)"\s*$/\1/p' "$greetd_conf.pikadots-orig" 2>/dev/null | head -1)
	[[ -z $u ]] && u=$(awk '$1 == "u" { print $2; exit }' /usr/lib/sysusers.d/greetd*.conf 2>/dev/null)
	if [[ -n $u ]] && getent passwd "$u" >/dev/null; then
		echo "$u"
		return
	fi
	for u in greeter greetd _greetd; do
		getent passwd "$u" >/dev/null && { echo "$u"; return; }
	done
	echo greeter
}

greeter_conf_current() {
	grep -qF "command = \"$(greeter_command)\"" "$greetd_conf" 2>/dev/null
}

greeter_dropin_text() {
	printf '[Service]\nExecStartPre=-/bin/sh -c '"'"'TERM=linux setterm --cursor off --clear all >/dev/tty1 </dev/tty1'"'"'\n'
}

greeter_dropin_current() {
	cmp -s <(greeter_dropin_text) "$greetd_dropin" 2>/dev/null
}

greeter_write_dropin() {
	sudo install -d "${greetd_dropin%/*}" &&
		greeter_dropin_text | sudo tee "$greetd_dropin" >/dev/null &&
		sudo systemctl daemon-reload
}

greeter_pam_current() {
	[[ ! -f $greetd_pam ]] || grep -q pam_gnome_keyring "$greetd_pam"
}

greeter_write_pam() {
	[[ -f $greetd_pam ]] || return 0
	[[ -f $greetd_pam.pikadots-orig ]] || sudo cp "$greetd_pam" "$greetd_pam.pikadots-orig" || return 1
	printf '%s\n' '-auth       optional     pam_gnome_keyring.so' '-session    optional     pam_gnome_keyring.so auto_start' |
		sudo tee -a "$greetd_pam" >/dev/null
}

greeter_outdated() {
	local f
	for f in "${qs_greeter_files[@]}"; do
		cmp -s "$qs_greeter_src/$f" "$qs_greeter_share/$f" || return 0
	done
	greeter_dropin_current || return 0
	greeter_pam_current || return 0
	[[ -f $qs_greeter_state/fonts.conf ]] || return 0
	[[ $(display_manager) != greetd ]] || ! greeter_conf_current
}

greeter_copy_files() {
	sudo install -d -m 755 "$qs_greeter_share" &&
		sudo install -m 644 "${qs_greeter_files[@]/#/$qs_greeter_src/}" "$qs_greeter_share/"
}

greeter_write_conf() {
	if [[ -f $greetd_conf && ! -f $greetd_conf.pikadots-orig ]] && ! grep -qF "$qs_greeter_share" "$greetd_conf"; then
		sudo cp "$greetd_conf" "$greetd_conf.pikadots-orig"
	fi
	sudo install -d /etc/greetd
	sudo tee "$greetd_conf" >/dev/null <<-EOF
		[terminal]
		vt = 1

		[default_session]
		command = "$(greeter_command)"
		user = "$(greetd_user)"
	EOF
}

greeter_refresh() {
	[[ -f $qs_greeter_share/shell.qml ]] || return 0
	if ! greeter_outdated; then
		ok "pikadots greeter is up to date"
		return
	fi
	local tmp
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"; trap - RETURN' RETURN
	greeter_stage "$tmp"
	if greeter_copy_files && { greeter_dropin_current || greeter_write_dropin; } &&
		{ greeter_pam_current || greeter_write_pam; } &&
		greeter_copy_theme "$tmp" &&
		{ [[ $(display_manager) != greetd ]] || greeter_conf_current || greeter_write_conf; }; then
		ok "pikadots greeter updated with the wallpaper, colors and fonts (shows at the next login)"
	else
		bad "couldn't update the pikadots greeter; run pikadots greeter install"
	fi
}

greeter_stage() {
	local out=$1 img ext layout
	mkdir -p "$out/faces"
	img=$(wallpaper)
	if [[ -n $img ]]; then
		ext=${img##*.}
		cp "$img" "$out/wallpaper.${ext,,}"
	fi
	[[ -f $HOME/.face ]] && cp "$HOME/.face" "$out/faces/$USER"
	greeter_stage_fonts "$out"
	layout=$(hyprctl getoption input:kb_layout -j 2>/dev/null | jq -r '.str // empty' 2>/dev/null)
	printf '%s\n' "${layout:-us}" >"$out/kb_layout"
	jq -n \
		--slurpfile colors <(cat "$HOME/.local/state/theme/quickshell.json" 2>/dev/null || echo '{}') \
		--slurpfile settings <(cat "$HOME/.config/pikadots/settings.json" 2>/dev/null || echo '{}') \
		--argjson fonts "$(cd "$out" && find fonts -type f 2>/dev/null | sort | jq -R . | jq -sc .)" \
		--arg wallpaper "${img:+wallpaper.${ext,,}}" --arg user "$USER" '
		($colors[0] // {}) as $c | ($settings[0] // {}) as $s |
		($c | with_entries(select(.key | IN("base", "surface", "overlay", "text", "subtext", "accent", "accentText", "red", "green", "yellow")))) + {
			font: ($s.appearance.font // "Fira Sans"),
			displayFont: ($s.appearance.displayFont // "Fira Sans"),
			iconStyle: ($s.appearance.iconStyle // "Rounded"),
			iconWeight: ($s.appearance.iconWeight // 400),
			fontSize: ($s.appearance.fontSize // 13),
			roundness: ($s.appearance.roundness // 1),
			barHeight: ($s.bar.height // 46),
			barGap: ($s.bar.gap // 4),
			clock24: ($s.bar.clock24 // false),
			fontFiles: $fonts,
			blur: ($s.lock.blur // 0.85),
			restSeconds: ($s.lock.restSeconds // 15),
			showPower: ($s.lock.showPower | if . == null then true else . end),
			wallpaper: $wallpaper,
			user: $user,
			session: "hyprland.desktop"
		}' >"$out/theme.json"
}

greeter_stage_fonts() {
	local out=$1 family file
	mkdir -p "$out/fonts"
	for family in "$(setting .appearance.font "Fira Sans")" "$(setting .appearance.displayFont "Fira Sans")" \
		"Material Symbols $(setting .appearance.iconStyle Rounded)"; do
		while IFS= read -r file; do
			[[ -f $file && ! -e $out/fonts/${file##*/} ]] && cp "$file" "$out/fonts/"
		done < <(fc-list "$family" file 2>/dev/null | sed 's/: *$//' | grep -E '\.(ttf|otf|ttc|woff2?)$')
	done
	cat >"$out/fonts.conf" <<-EOF
		<?xml version="1.0"?>
		<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
		<fontconfig>
			<include ignore_missing="yes">/etc/fonts/fonts.conf</include>
			<dir prefix="relative">fonts</dir>
		</fontconfig>
	EOF
}

greeter_copy_theme() {
	local staged=$1 user
	user=$(greetd_user)
	sudo install -d -m 755 "$qs_greeter_state" "$qs_greeter_state/faces" || return 1
	sudo find "$qs_greeter_state" -maxdepth 1 -name 'wallpaper.*' -delete
	sudo rm -rf "$qs_greeter_state/fonts"
	sudo cp -r "$staged/." "$qs_greeter_state/" || return 1
	sudo chmod -R a+rX "$qs_greeter_state"
	sudo chown -R "$USER" "$qs_greeter_state"
	sudo touch "$qs_greeter_state/last"
	getent passwd "$user" >/dev/null && sudo chown "$user" "$qs_greeter_state/last"
	return 0
}

greeter_sync() {
	if [[ ${1:-} == --later ]]; then
		local token="$BASHPID $(date +%s%N)"
		mkdir -p "$state"
		printf '%s\n' "$token" >"$state/greeter-sync"
		sleep "${PIKADOTS_GREETER_DELAY:-2}"
		[[ $(cat "$state/greeter-sync" 2>/dev/null) == "$token" ]] || return 0
		rm -f "$state/greeter-sync"
	fi
	[[ -f $qs_greeter_share/shell.qml ]] || { [[ -n ${1:-} ]] || info "the pikadots greeter isn't installed"; return 0; }
	if [[ ! -O $qs_greeter_state ]]; then
		[[ -n ${1:-} ]] || warn "run pikadots greeter once so wallpaper changes can update the login screen without sudo"
		return 0
	fi
	local tmp f
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"; trap - RETURN' RETURN
	greeter_stage "$tmp"
	if cmp -s "$tmp/theme.json" "$qs_greeter_state/theme.json" && cmp -s "$tmp/kb_layout" "$qs_greeter_state/kb_layout" &&
		cmp -s "$tmp/faces/$USER" "$qs_greeter_state/faces/$USER" 2>/dev/null; then
		f=$(find "$tmp" -maxdepth 1 -name 'wallpaper.*' | head -1)
		if [[ -z $f ]] || cmp -s "$f" "$qs_greeter_state/${f##*/}"; then
			[[ -n ${1:-} ]] || ok "login screen already matches the wallpaper"
			return 0
		fi
	fi
	find "$qs_greeter_state" -maxdepth 1 -name 'wallpaper.*' -delete
	rm -rf "$qs_greeter_state/fonts"
	cp -r "$tmp/." "$qs_greeter_state/" && chmod -R a+rX "$qs_greeter_state" 2>/dev/null
	[[ -n ${1:-} ]] || ok "login screen updated with the wallpaper, colors and fonts"
}

greeter_preview() {
	local tmp
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"; trap - RETURN' RETURN
	greeter_stage "$tmp"
	info "showing the greeter as it would look; press Esc to close it"
	PIKADOTS_GREETER_DIR=$tmp FONTCONFIG_FILE=$tmp/fonts.conf qs -p "$qs_greeter_src" >/dev/null 2>&1
}

greeter_install() {
	local dm tmp fresh=true
	dm=$(display_manager)
	[[ -f $qs_greeter_share/shell.qml ]] && fresh=false
	[[ -n $pm ]] || die "needs pacman or dnf"
	has Hyprland || die "Hyprland isn't installed"
	if [[ $dm == greetd ]] && sudo test -f "$qs_greeter_share/shell.qml"; then
		ok "the pikadots greeter is already installed; refreshing its wallpaper and colors"
	fi
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"; trap - RETURN' RETURN
	greeter_stage "$tmp"
	info "with sudo, this will:"
	has greetd || info "  install greetd"
	info "  copy the greeter to $qs_greeter_share"
	info "  copy your wallpaper, colors, fonts and picture to $qs_greeter_state"
	greeter_dropin_current || info "  add $greetd_dropin, which hides the console cursor behind the login screen"
	greeter_pam_current || info "  let greetd unlock your keyring at login ($greetd_pam, the current one is kept)"
	if [[ $dm != greetd ]] || ! greeter_conf_current; then
		info "  write $greetd_conf (the current one is kept as $greetd_conf.pikadots-orig)"
		[[ $dm != greetd ]] && info "  switch the login screen from ${dm:-none} to greetd (shows at the next boot)"
		info "  pikadots greeter remove undoes it, also from a text console (Ctrl + Alt + F3)"
	fi
	confirm "Install the pikadots greeter?" || exit 0
	if ! has greetd; then
		pkg_install -y greetd || die "couldn't install greetd"
	fi
	greeter_copy_files || die "sudo failed"
	greeter_dropin_current || greeter_write_dropin || die "couldn't write $greetd_dropin"
	greeter_pam_current || greeter_write_pam || die "couldn't update $greetd_pam"
	greeter_copy_theme "$tmp" || die "sudo failed"
	$fresh && [[ -n $dm ]] && ! sudo test -f "$qs_greeter_state/previous" &&
		printf '%s\n' "$dm" | sudo tee "$qs_greeter_state/previous" >/dev/null
	greeter_conf_current || greeter_write_conf || die "couldn't write $greetd_conf"
	[[ $dm == greetd ]] && { ok "greeter updated (shows at the next login)"; return; }
	[[ -n $dm ]] && sudo systemctl disable "$dm.service"
	sudo systemctl enable greetd.service || die "couldn't enable greetd"
	ok "greetd and the pikadots greeter will show at the next boot"
	info "if it ever fails to start, log in on a text console (Ctrl + Alt + F3) and run: pikadots greeter remove"
}

fallback_display_manager() {
	local d
	for d in plasmalogin sddm gdm lightdm ly; do
		systemctl cat "$d.service" >/dev/null 2>&1 && { echo "$d"; return 0; }
	done
	[[ -f $greetd_conf.pikadots-orig ]] && echo greetd
}

greeter_remove() {
	local dm previous
	dm=$(display_manager)
	previous=$(cat "$qs_greeter_state/previous" 2>/dev/null)
	[[ $previous == greetd && ! -f $greetd_conf.pikadots-orig ]] && previous=
	[[ -z $previous ]] && previous=$(fallback_display_manager)
	info "with sudo, this will:"
	if [[ $dm == greetd ]]; then
		case $previous in
		greetd) info "  keep greetd with its previous settings" ;;
		"") info "  turn greetd off: no other login screen is installed, so the next boot ends at a text console" ;;
		*) info "  switch the login screen back to $previous" ;;
		esac
	fi
	[[ -f $greetd_conf.pikadots-orig ]] && info "  put back $greetd_conf"
	info "  remove $qs_greeter_share and $qs_greeter_state"
	[[ -f $greetd_dropin ]] && info "  remove $greetd_dropin"
	[[ -f $greetd_pam.pikadots-orig ]] && info "  put back $greetd_pam"
	confirm "Remove the pikadots greeter?" || exit 0
	if [[ $dm == greetd && $previous != greetd ]]; then
		sudo systemctl disable greetd.service || die "sudo failed"
		if [[ -n $previous ]] && ! sudo systemctl enable "$previous.service"; then
			bad "couldn't enable $previous; run: sudo systemctl enable $previous.service"
			previous=
		fi
	fi
	[[ -f $greetd_conf.pikadots-orig ]] && sudo mv "$greetd_conf.pikadots-orig" "$greetd_conf"
	sudo rm -rf "$qs_greeter_share" "$qs_greeter_state"
	[[ -f $greetd_pam.pikadots-orig ]] && sudo mv "$greetd_pam.pikadots-orig" "$greetd_pam"
	if [[ -f $greetd_dropin ]]; then
		sudo rm -f "$greetd_dropin"
		sudo rmdir --ignore-fail-on-non-empty "${greetd_dropin%/*}"
		sudo systemctl daemon-reload
	fi
	if [[ -n $previous ]]; then
		ok "pikadots greeter removed ($previous shows at the next boot)"
	else
		warn "pikadots greeter removed; no login screen is enabled, so the next boot ends at a text console"
		info "log in there and run start-hyprland (or Hyprland), or install a login screen such as sddm and enable it"
	fi
}

cmd_greeter() {
	printf '%spikadots greeter%s\n' "$bold" "$reset"
	case ${1:-} in
	install) greeter_install ;;
	remove) greeter_remove ;;
	preview) greeter_preview ;;
	sync) greeter_sync "${2:-}" ;;
	--reset) plm_theme_reset ;;
	"")
		if [[ $(display_manager) == greetd && -f $qs_greeter_share/shell.qml ]]; then
			greeter_install
		else
			plm_theme_apply
		fi
		;;
	*) die "usage: pikadots greeter [install|remove|preview|sync|--reset]" ;;
	esac
}

plm_theme_reset() {
	if [[ ! -e $plm_theme_conf && ! -d $plm_theme_dir ]]; then
		ok "the login screen already uses its own settings"
		return
	fi
	info "with sudo, this will:"
	info "  remove $plm_theme_conf and $plm_theme_dir"
	info "  put back the login screen's previous colors ($plm_kdeglobals)"
	confirm "Reset the login screen?" || exit 0
	sudo rm -f "$plm_theme_conf" || die "sudo failed"
	if sudo test -f "$plm_theme_dir/kdeglobals.orig" && getent passwd plasmalogin >/dev/null; then
		sudo install -o plasmalogin -g plasmalogin -m 644 "$plm_theme_dir/kdeglobals.orig" "$plm_kdeglobals"
	elif sudo test -f "$plm_theme_dir/kdeglobals.none"; then
		sudo rm -f "$plm_kdeglobals"
	fi
	sudo rm -rf "$plm_theme_dir"
	ok "login screen back to its defaults (shows at the next login)"
}

plm_theme_apply() {
	local dm img ext tmp colors
	dm=$(display_manager)
	[[ $dm == plasmalogin ]] ||
		die "only Plasma Login Manager is supported (this machine uses ${dm:-no display manager})"
	img=$(wallpaper)
	[[ -n $img ]] || die "no wallpaper set"
	ext=${img##*.}
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"; trap - RETURN' RETURN
	cat >"$tmp/pikadots.conf" <<-EOF
		[Greeter]
		WallpaperPluginId=org.kde.image

		[Greeter][Wallpaper][org.kde.image][General]
		Image=file://$plm_theme_dir/wallpaper.${ext,,}
	EOF
	colors=$(plm_theme_colors) && printf '%s\n' "$colors" >"$tmp/kdeglobals"

	info "with sudo, this will:"
	info "  copy ${img/#$HOME/\~} to $plm_theme_dir/wallpaper.${ext,,}"
	info "  write $plm_theme_conf:"
	sed 's/^/        /' "$tmp/pikadots.conf"
	if [[ -f $tmp/kdeglobals ]]; then
		info "  give the login screen the wallpaper colors ($(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | grep -q dark && echo dark || echo light), accent $(jq -r .accent "$HOME/.local/state/theme/quickshell.json" 2>/dev/null)):"
		info "    $plm_kdeglobals (the current one is kept for --reset)"
	else
		info "  colors stay as they are (the Qt/KDE theme isn't applied; Settings > Appearance)"
	fi
	grep -qs '^\[Greeter\]\[Wallpaper\]' /etc/plasmalogin.conf &&
		warn "/etc/plasmalogin.conf sets its own wallpaper, which wins over pikadots.conf; clear it in System Settings > Login Screen"
	confirm "Apply?" || exit 0

	sudo install -Dm 644 "$img" "$plm_theme_dir/wallpaper.${ext,,}" || die "sudo failed"
	sudo install -Dm 644 "$tmp/pikadots.conf" "$plm_theme_conf"
	if [[ -f $tmp/kdeglobals ]]; then
		if ! sudo test -e "$plm_theme_dir/kdeglobals.orig" && ! sudo test -e "$plm_theme_dir/kdeglobals.none"; then
			if sudo test -f "$plm_kdeglobals"; then
				sudo cp "$plm_kdeglobals" "$plm_theme_dir/kdeglobals.orig"
			else
				sudo touch "$plm_theme_dir/kdeglobals.none"
			fi
		fi
		sudo install -d -o plasmalogin -g plasmalogin -m 755 "${plm_kdeglobals%/*}"
		sudo install -o plasmalogin -g plasmalogin -m 644 "$tmp/kdeglobals" "$plm_kdeglobals"
	fi
	ok "login screen updated (shows at the next login; pikadots greeter --reset undoes it)"
	info "run it again after changing the wallpaper"
}

splash_dir=/usr/share/plymouth/themes/pikadots

rgb() { awk -v h="${1#\#}" 'BEGIN { printf "%.3f, %.3f, %.3f", strtonum("0x" substr(h, 1, 2)) / 255, strtonum("0x" substr(h, 3, 2)) / 255, strtonum("0x" substr(h, 5, 2)) / 255 }'; }

splash_logo() {
	local id f
	id=$(sed -n 's/^LOGO=//p' /etc/os-release 2>/dev/null | tr -d '"')
	for f in ${id:+/usr/share/icons/Papirus/64x64/apps/distributor-logo-$id.svg /usr/share/icons/$id.svg \
		/usr/share/icons/hicolor/scalable/apps/$id.svg /usr/share/pixmaps/$id.svg /usr/share/pixmaps/$id.png} \
		/usr/share/icons/Papirus/64x64/apps/distributor-logo-archlinux.svg /usr/share/pixmaps/archlinux-logo.svg; do
		[[ -f $f ]] && { echo "$f"; return; }
	done
	return 1
}

cmd_splash() {
	printf '%spikadots splash%s\n' "$bold" "$reset"
	has plymouth-set-default-theme || die "plymouth isn't installed"
	local current previous palette=$HOME/.local/state/theme/quickshell.json
	current=$(plymouth-set-default-theme)
	if [[ ${1:-} == --reset ]]; then
		if [[ $current != pikadots && ! -d $splash_dir ]]; then
			ok "the boot splash is already $current"
			return
		fi
		previous=$(cat "$state/splash-previous" 2>/dev/null || cat "$splash_dir/previous" 2>/dev/null)
		info "with sudo, this will:"
		if [[ -n $previous ]]; then
			info "  switch the boot splash from $current back to $previous and rebuild the initramfs"
		else
			info "  no earlier splash was recorded, so switch to the distribution default and rebuild the initramfs"
		fi
		info "  remove $splash_dir"
		confirm "Restore ${previous:-the default splash}?" || exit 0
		if [[ -n $previous && -d /usr/share/plymouth/themes/$previous ]]; then
			sudo plymouth-set-default-theme -R "$previous" || die "plymouth-set-default-theme failed"
		else
			sudo plymouth-set-default-theme --reset --rebuild-initrd || die "plymouth-set-default-theme failed"
			previous=$(plymouth-set-default-theme)
		fi
		sudo rm -rf "$splash_dir"
		rm -f "$state/splash-previous"
		ok "boot splash: $previous"
		return
	fi
	[[ -f $palette ]] || die "no wallpaper colors yet (pikadots repair)"
	local base text subtext accent surface logo tmp
	base=$(jq -r .base "$palette") text=$(jq -r .text "$palette") subtext=$(jq -r .subtext "$palette")
	accent=$(jq -r .accent "$palette") surface=$(jq -r .surface "$palette")
	logo=$(splash_logo) || die "no distribution logo found"
	has magick || die "imagemagick isn't installed"
	local plugins need_plugin=
	plugins=$(plymouth --get-splash-plugin-path 2>/dev/null)
	if [[ ! -f ${plugins:-/usr/lib/plymouth/}script.so ]]; then
		[[ $pm == dnf ]] || die "plymouth's script plugin is missing"
		need_plugin=1
	fi
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"; trap - RETURN' RETURN
	magick -background none -density 600 "$logo" -resize 160x160 -fill "$text" -colorize 100 "$tmp/logo.png" &&
		magick -size 72x72 xc:none -fill none -strokewidth 6 -stroke "$surface" -draw 'circle 36,36 36,6' \
			-stroke "$accent" -draw 'arc 6,6 66,66 -90,30' -depth 8 "$tmp/spinner.png" || die "couldn't draw the splash images"
	cp "$pkgdir/plymouth/pikadots.plymouth" "$tmp/"
	sed -e "s/@BASE@/$(rgb "$base")/g" -e "s/@TEXT@/$(rgb "$text")/g" -e "s/@SUBTEXT@/$(rgb "$subtext")/g" \
		-e "s/@ACCENT@/$(rgb "$accent")/g" "$pkgdir/plymouth/pikadots.script" >"$tmp/pikadots.script"

	info "with sudo, this will:"
	[[ -n $need_plugin ]] && info "  install plymouth-plugin-script (Fedora doesn't include plymouth's script plugin by default)"
	info "  install a pikadots theme in $splash_dir: the ${logo##*/} logo over $base, spinner in $accent"
	info "  switch the boot splash from $current to pikadots and rebuild the initramfs (takes a minute)"
	[[ $current == pikadots ]] || info "  remember $current, so pikadots splash --reset can bring it back"
	grep -qwE 'splash|rhgb' /proc/cmdline || warn "the kernel command line has no 'splash' (or 'rhgb'), so the splash may not show"
	confirm "Install the boot splash?" || exit 0
	if [[ -n $need_plugin ]]; then
		sudo dnf install -y plymouth-plugin-script >/dev/null || die "couldn't install plymouth-plugin-script"
	fi

	if [[ $current != pikadots ]]; then
		mkdir -p "$state"
		echo "$current" >"$state/splash-previous"
	fi
	sudo install -d "$splash_dir" || die "sudo failed"
	sudo install -m 644 "$tmp"/{pikadots.plymouth,pikadots.script,logo.png,spinner.png} "$splash_dir/"
	[[ -s $state/splash-previous ]] && sudo install -m 644 "$state/splash-previous" "$splash_dir/previous"
	sudo plymouth-set-default-theme -R pikadots || die "plymouth-set-default-theme failed"
	ok "boot splash: pikadots (pikadots splash --reset brings back $(cat "$state/splash-previous" 2>/dev/null || echo the old one))"
	info "run it again after changing the wallpaper"
}

cmd_keybinds() {
	local rel=config/hypr/keybinds.lua
	local modified=0
	if ! git -C "$repo" cat-file -e "HEAD:$rel" 2>/dev/null; then
		modified=-1
	elif ! git -C "$repo" diff --quiet HEAD -- "$rel"; then
		modified=1
	fi
	case ${1:-status} in
	status)
		case $modified in
		-1) echo unknown ;;
		1) echo modified ;;
		*) echo default ;;
		esac
		;;
	reset)
		step "Keybindings"
		if ((modified == 1)); then
			mkdir -p "$backups"
			local copy=$backups/keybinds-$(date +%Y%m%d-%H%M%S).lua
			cp "$repo/$rel" "$copy"
			git -C "$repo" checkout HEAD -- "$rel" && ok "keybinds.lua restored to the default (your edited copy: $copy)"
		elif ((modified == -1)); then
			warn "$repo isn't a git checkout, so keybinds.lua can't be restored"
		else
			ok "keybinds.lua is already the default"
		fi
		if pgrep -x qs >/dev/null && qs ipc call keybinds clear >/dev/null 2>&1; then
			ok "Settings shortcut changes cleared"
		elif [[ -f $pikadots_settings ]]; then
			jq --indent 4 '.keybinds = {}' "$pikadots_settings" >"$pikadots_settings.tmp" &&
				mv "$pikadots_settings.tmp" "$pikadots_settings" && ok "Settings shortcut changes cleared"
		fi
		mkdir -p "$state"
		printf 'return {}\n' >"$state/keybinds.lua"
		hyprctl reload >/dev/null 2>&1 && ok "Hyprland reloaded"
		;;
	*) die "usage: pikadots keybinds [status|reset]" ;;
	esac
}

cmd_docs_check() {
	python3 -I "$pkgdir/pikadots/docs-check.py" "$repo" "$@"
}

usage() {
	cat <<'EOF'
pikadots: install, check and maintain these dotfiles (Hyprland + Quickshell on Arch Linux,
CachyOS or Fedora).

  pikadots install      packages, links into $HOME (existing files backed up), services, colors
  pikadots uninstall    remove the links, restore the backed-up files, stop the backup timer,
                        undo the Qt/KDE, VS Code, Zen, Thunderbird and Pywalfox setup, the
                        notifier masks and default apps pikadots set, offer to remove the login
                        screen, greeter and boot splash, then optionally remove the packages
                        pikadots installed
  pikadots health       check packages, links, services, configs, keyring, backups, …
  pikadots repair       fix what health finds: packages, links, services, colors, reloads
  pikadots link         link the files in config/ into $HOME (see the links table)
  pikadots update       pull the repo, then repair if anything new came in (with a snapper
                        snapshot first when snapper is set up and snap-pac isn't)
  pikadots backup       back up now (restic; see pikadots-backup)
  pikadots backup-init  create the backup password and repository, enable the daily backup
  pikadots export [FILE]  save the Settings app's choices, wallpaper and profile picture to one
                        file (default ~/pikadots-settings-DATE.tar.gz) to set up another machine
  pikadots import FILE  apply an exported file (or a settings.json); your current ones are backed up
  pikadots setup        go through the welcome steps again (wallpaper, bar, dock, widgets,
                        picture, keys)
  pikadots greeter [--reset]  login screen (Plasma Login Manager) with the wallpaper and its colors;
                        shows what it changes, asks, then uses sudo
  pikadots greeter install|remove|preview|sync  the pikadots greeter: a Quickshell login screen
                        that looks like the lock screen, on greetd; install switches to it,
                        remove goes back to the previous login screen, preview shows it now
                        without changing anything, sync copies the wallpaper, colors and fonts
                        to it without sudo (done by itself a few seconds after a wallpaper change)
  pikadots splash [--reset]   boot splash (Plymouth) with the distro logo and an accent spinner;
                        shows what it changes, asks, then uses sudo; --reset restores the old one
  pikadots keybinds [status|reset]  status says whether keybinds.lua differs from the repo's
                        committed one; reset restores it (your edited copy is backed up) and
                        clears the shortcuts changed in Settings > Keybindings
  pikadots docs-check   compare config/hypr/keybinds.lua with docs/keybindings.md
EOF
}

case ${1:-help} in
	install) cmd_install ;;
	link) step "Links"; link_packages ;;
	uninstall) cmd_uninstall ;;
	health | check | doctor) cmd_health ;;
	repair | fix) cmd_repair ;;
	update) cmd_update ;;
	backup) cmd_backup ;;
	backup-init) cmd_backup_init ;;
	export) cmd_export "${2:-}" ;;
	import) cmd_import "${2:-}" ;;
	setup) qs ipc call setup open >/dev/null || die "the shell isn't running (log in to Hyprland first)" ;;
	greeter) cmd_greeter "${2:-}" "${3:-}" ;;
	splash) cmd_splash "${2:-}" ;;
	keybinds) cmd_keybinds "${2:-}" ;;
	docs-check) cmd_docs_check ;;
	help | -h | --help) usage ;;
	*) usage; exit 1 ;;
esac
