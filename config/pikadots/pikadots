#!/usr/bin/env bash
set -uo pipefail

self=$(readlink -f "${BASH_SOURCE[0]}")
repo=${PIKADOTS_DIR:-$(git -C "$(dirname "$self")" rev-parse --show-toplevel 2>/dev/null || (cd "$(dirname "$self")/../.." && pwd))}
pkgdir=$repo/config
state=$HOME/.local/state/pikadots
backups=$state/backups

links=(
	"hypr .config/hypr"
	"quickshell .config/quickshell"
	"kitty .config/kitty"
	"matugen .config/matugen"
	"fastfetch .config/fastfetch"
	"fontconfig .config/fontconfig"
	"fuzzel .config/fuzzel"
	"git .config/git"
	"lazygit/config.yml .config/lazygit/config.yml"
	"btop/btop.conf .config/btop/btop.conf"
	"mpv/mpv.conf .config/mpv/mpv.conf"
	"cava/config .config/cava/config"
	"superfile/config.toml .config/superfile/config.toml"
	"superfile/hotkeys.toml .config/superfile/hotkeys.toml"
	"superfile/superfile.desktop .local/share/applications/superfile.desktop"
	"gtk/gtk-3.0.css .config/gtk-3.0/gtk.css"
	"gtk/gtk-4.0.css .config/gtk-4.0/gtk.css"
	"starship/starship.toml .config/starship.toml"
	"zsh/zshrc .zshrc"
	"plasma/pikadots.sh .config/plasma-workspace/env/pikadots.sh"
	"pikadots/pikadots .local/bin/pikadots"
	"pikadots/pikadots-backup .local/bin/pikadots-backup"
	"pikadots/pikadots-meetings .local/bin/pikadots-meetings"
	"pikadots/pywalfox-host .local/bin/pywalfox-host"
	"pikadots/cmatrix .local/bin/cmatrix"
	"pikadots/pikadots-backup.service .config/systemd/user/pikadots-backup.service"
	"pikadots/pikadots-backup.timer .config/systemd/user/pikadots-backup.timer"
	"pikadots/pikadots-settings.desktop .local/share/applications/pikadots-settings.desktop"
)
services=(gcr-ssh-agent.socket)
system_services=(NetworkManager.service bluetooth.service power-profiles-daemon.service)
other_notifiers=(mako.service dunst.service swaync.service)
keep_packages=(networkmanager networkmanager-openvpn bluez bluez-utils pipewire-pulse wireplumber
	upower power-profiles-daemon zsh git neovim xdg-utils xdg-user-dirs gnome-keyring libsecret
	restic asusctl)

if [[ -t 1 ]]; then
	bold=$'\e[1m' dim=$'\e[2m' red=$'\e[31m' green=$'\e[32m' yellow=$'\e[33m' blue=$'\e[34m' reset=$'\e[0m'
else
	bold= dim= red= green= yellow= blue= reset=
fi
problems=0
step() { printf '\n%s%s::%s %s%s\n' "$bold" "$blue" "$reset$bold" "$*" "$reset"; }
ok() { printf '  %s✓%s %s\n' "$green" "$reset" "$*"; }
warn() { printf '  %s!%s %s\n' "$yellow" "$reset" "$*"; }
bad() { printf '  %s✗%s %s\n' "$red" "$reset" "$*"; problems=$((problems + 1)); }
info() { printf '  %s%s%s\n' "$dim" "$*" "$reset"; }
die() { printf '%serror:%s %s\n' "$red" "$reset" "$*" >&2; exit 1; }
confirm() {
	local answer
	read -rp "  $1 [y/N] " answer
	[[ $answer == [yY]* ]]
}

linked() {
	[[ -L $HOME/$2 && $(readlink -f "$HOME/$2") == "$(readlink -f "$pkgdir/$1")" ]]
}

list() { grep -vE '^\s*(#|$)' "$repo/$1" 2>/dev/null; }

is_asus() { grep -qi asus /sys/class/dmi/id/sys_vendor 2>/dev/null; }

wanted_packages() {
	list packages.txt
	is_asus && echo asusctl
}

missing_packages() { wanted_packages | xargs -r pacman -T 2>/dev/null; }

aur_helper() { command -v paru || command -v yay; }

record_installed() {
	mkdir -p "$state"
	printf '%s\n' "$@" | cat - "$state/installed-packages" 2>/dev/null | sort -u >"$state/installed-packages.tmp"
	mv "$state/installed-packages.tmp" "$state/installed-packages"
}

removable_packages() {
	local candidates
	if [[ -s $state/installed-packages ]]; then
		candidates=$(cat "$state/installed-packages")
	else
		candidates=$(list packages.txt; list aur.txt)
	fi
	candidates=$(printf '%s\n' $candidates | grep -vxF -f <(printf '%s\n' "${keep_packages[@]}") |
		xargs -r pacman -Qq 2>/dev/null)
	[[ -z $candidates ]] && return
	LC_ALL=C pacman -Qi $candidates 2>/dev/null | awk -v list="$(echo $candidates)" '
		BEGIN { n = split(list, a, " "); for (i = 1; i <= n; i++) want[a[i]] = 1 }
		/^Name/ { name = $3; ok = 1; inreq = 0 }
		/^Required By/ { inreq = 1; sub(/^Required By *: */, "") }
		/^[A-Z][a-zA-Z ]*:/ && !/^Required By/ { if (inreq) { if (ok) print name; inreq = 0 } }
		inreq { for (i = 1; i <= NF; i++) if ($i != "None" && !($i in want)) ok = 0 }
	'
}

remove_packages() {
	local pkgs list_file
	pkgs=$(removable_packages)
	if [[ -z $pkgs ]]; then
		info "no packages to remove"
		return
	fi
	if [[ -s $state/installed-packages ]]; then
		info "packages pikadots installed (essentials like networkmanager, zsh, git are never listed):"
	else
		info "pikadots didn't record what it installed, so these are from packages.txt; some may have"
		info "been installed before pikadots (essentials like networkmanager, zsh, git are never listed):"
	fi
	printf '%s\n' $pkgs | column -c "${COLUMNS:-100}" | sed 's/^/    /'
	[[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] &&
		warn "you're in Hyprland: removing hyprland and quickshell ends this session on next login"
	local answer
	read -rp "  Remove them? [y]es / [e]dit the list / [N]o " answer
	case $answer in
	[yY]*) ;;
	[eE]*)
		list_file=$(mktemp --suffix=.txt)
		{
			echo "# Delete the lines of packages to keep, then save and quit. # lines are ignored."
			printf '%s\n' $pkgs
		} >"$list_file"
		${EDITOR:-nvim} "$list_file" </dev/tty
		pkgs=$(grep -vE '^\s*(#|$)' "$list_file" | grep -xF -f <(printf '%s\n' $pkgs))
		rm -f "$list_file"
		[[ -z $pkgs ]] && { info "nothing selected"; return; }
		info "removing: $(echo $pkgs)"
		;;
	*) info "packages kept"; return ;;
	esac
	if sudo pacman -Rns $pkgs; then
		ok "removed $(echo $pkgs | wc -w) package(s)"
		[[ -f $state/installed-packages ]] &&
			grep -vxF -f <(printf '%s\n' $pkgs) "$state/installed-packages" >"$state/installed-packages.tmp" &&
			mv "$state/installed-packages.tmp" "$state/installed-packages"
	else
		bad "pacman didn't remove them"
	fi
}

install_packages() {
	command -v pacman >/dev/null || die "pacman not found: pikadots needs Arch Linux or a derivative"
	local missing
	missing=$(missing_packages)
	if [[ -n $missing ]]; then
		info "installing: $(echo $missing)"
		sudo pacman -S --needed $missing || die "pacman failed"
		record_installed $missing
	fi
	ok "packages installed"

	local aur helper
	aur=$(list aur.txt | xargs -r pacman -T 2>/dev/null)
	if [[ -n $aur ]]; then
		if helper=$(aur_helper); then
			if "$helper" -S --needed $aur; then
				ok "AUR packages installed"
				record_installed $aur
			else
				warn "AUR install failed: $(echo $aur)"
			fi
		else
			warn "no AUR helper (yay/paru); skipped: $(echo $aur)"
		fi
	fi
}

link_packages() {
	local backup="$backups/$(date +%Y%m%d-%H%M%S)" moved=0 entry src dst
	for entry in "${links[@]}"; do
		read -r src dst <<<"$entry"
		[[ -e $pkgdir/$src ]] || continue
		if linked "$src" "$dst"; then
			ok "$dst"
			continue
		fi
		if [[ -e $HOME/$dst && ! -L $HOME/$dst ]]; then
			mkdir -p "$backup/$(dirname "$dst")"
			mv "$HOME/$dst" "$backup/$dst" && moved=$((moved + 1))
		fi
		local part=$HOME rest=$(dirname "$dst")
		while [[ $rest != . ]]; do
			part=$part/${rest%%/*}
			[[ -L $part && ! -e $part ]] && rm "$part"
			[[ $rest == */* ]] && rest=${rest#*/} || rest=.
		done
		mkdir -p "$(dirname "$HOME/$dst")"
		if ln -sfnr "$pkgdir/$src" "$HOME/$dst"; then
			ok "linked $dst"
		else
			bad "couldn't link $dst"
		fi
	done
	((moved > 0)) && info "moved $moved existing file(s) to ${backup/#$HOME/\~}"
	return 0
}

enable_services() {
	local s
	for s in "${system_services[@]}"; do
		systemctl is-enabled -q "$s" 2>/dev/null && continue
		sudo systemctl enable --now "$s" >/dev/null 2>&1 && ok "$s" || bad "couldn't enable $s"
	done
	systemctl --user daemon-reload
	for s in "${other_notifiers[@]}"; do
		systemctl --user cat "$s" >/dev/null 2>&1 || continue
		[[ $(systemctl --user is-enabled "$s" 2>/dev/null) == masked ]] && continue
		systemctl --user mask --now "$s" >/dev/null 2>&1 && ok "masked $s (Quickshell shows notifications)"
	done
	for s in "${services[@]}"; do
		systemctl --user enable --now "$s" >/dev/null 2>&1 && ok "$s" || bad "couldn't enable $s"
	done
	if [[ -f $HOME/.config/restic/password ]]; then
		systemctl --user enable --now pikadots-backup.timer >/dev/null 2>&1 && ok "daily backup timer"
	else
		info "backups not set up yet (pikadots backup-init)"
	fi
}

pywalfox_manifests=("$HOME/.mozilla/native-messaging-hosts/pywalfox.json"
	"$HOME/.config/mozilla/native-messaging-hosts/pywalfox.json")

setup_pywalfox() {
	command -v pywalfox >/dev/null || return 0
	local m
	for m in "${pywalfox_manifests[@]}"; do
		mkdir -p "${m%/*}"
		cat >"$m" <<-EOF
			{
			  "name": "pywalfox",
			  "description": "Pywalfox helper, one socket per browser (pikadots)",
			  "path": "$HOME/.local/bin/pywalfox-host",
			  "type": "stdio",
			  "allowed_extensions": ["pywalfox@frewacom.org"]
			}
		EOF
	done
	ok "Pywalfox helper for Zen and Firefox (add the Pywalfox extension in each)"
}

setup_default_apps() {
	local list="$HOME/.config/xdg-terminals.list" folders
	[[ -s $list ]] || echo kitty.desktop >"$list"
	folders=$(xdg-mime query default inode/directory 2>/dev/null)
	if [[ -z $folders || $folders == kitty-open.desktop ]]; then
		if command -v spf >/dev/null; then
			xdg-mime default superfile.desktop inode/directory
		elif [[ -f /usr/share/applications/thunar.desktop ]]; then
			xdg-mime default thunar.desktop inode/directory
		fi
	fi
	[[ -n $(xdg-mime query default text/plain 2>/dev/null) ]] || xdg-mime default nvim.desktop text/plain
	ok "default apps: terminal $(head -1 "$list"), browser $(xdg-settings get default-web-browser 2>/dev/null || echo none), files $(xdg-mime query default inode/directory), editor $(xdg-mime query default text/plain)"
}

setup_zen() {
	local ini dir profile css js line
	for ini in "$HOME/.config/zen/profiles.ini" "$HOME/.zen/profiles.ini"; do
		[[ -f $ini ]] || continue
		dir=${ini%/*}
		while IFS= read -r profile; do
			[[ -f $dir/$profile/prefs.js ]] || continue
			css=$dir/$profile/chrome/userChrome.css js=$dir/$profile/user.js
			line="@import url(\"file://$HOME/.local/state/theme/zen-userChrome.css\");"
			mkdir -p "${css%/*}"
			if ! grep -qsF "$line" "$css"; then
				{ echo "$line"; cat "$css" 2>/dev/null || true; } >"$css.tmp" && mv "$css.tmp" "$css"
			fi
			grep -qs legacyUserProfileCustomizations "$js" ||
				echo 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);' >>"$js"
			grep -qs zen.theme.disable-lightweight "$js" ||
				echo 'user_pref("zen.theme.disable-lightweight", false);' >>"$js"
			grep -qs zen.widget.linux.transparency "$js" ||
				echo 'user_pref("zen.widget.linux.transparency", true);' >>"$js"
			grep -qs browser.tabs.allow_transparent_browser "$js" ||
				echo 'user_pref("browser.tabs.allow_transparent_browser", true);' >>"$js"
			ok "Zen profile ${profile} uses the wallpaper colors (after Zen restarts)"
		done < <(sed -n 's/^Path=//p' "$ini")
	done
	return 0
}

setup_mpv() {
	command -v mpv >/dev/null || return 0
	mkdir -p "$state"
	[[ -e $state/mpv-font.conf ]] || : >"$state/mpv-font.conf"
	ok "mpv follows the wallpaper colors and the shell font"
}

setup_thunderbird() {
	local ini dir profile css js line
	line="@import url(\"file://$HOME/.local/state/theme/thunderbird-userChrome.css\");"
	for ini in "$HOME/.config/thunderbird/profiles.ini" "$HOME/.thunderbird/profiles.ini"; do
		[[ -f $ini ]] || continue
		dir=${ini%/*}
		while IFS= read -r profile; do
			[[ -f $dir/$profile/prefs.js ]] || continue
			css=$dir/$profile/chrome/userChrome.css js=$dir/$profile/user.js
			mkdir -p "${css%/*}"
			if ! grep -qsF "$line" "$css"; then
				{ echo "$line"; cat "$css" 2>/dev/null || true; } >"$css.tmp" && mv "$css.tmp" "$css"
			fi
			grep -qs legacyUserProfileCustomizations "$js" ||
				echo 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);' >>"$js"
			ok "Thunderbird profile ${profile} uses the wallpaper colors (after Thunderbird restarts)"
		done < <(sed -n 's/^Path=//p' "$ini")
	done
	return 0
}

setup_vscode() {
	command -v code-oss >/dev/null || command -v code >/dev/null || command -v codium >/dev/null || return 0
	local out line
	if out=$(python3 -I "$pkgdir/hypr/scripts/vscode-theme.py" install 2>&1); then
		while IFS= read -r line; do
			[[ -n $line ]] && ok "$line (live)"
		done <<<"$out"
	else
		warn "VS Code theme: ${out//$'\n'/; }"
	fi
	return 0
}

git_identity() {
	[[ -f $HOME/.config/git/user ]] && return
	local name email
	printf '  Your name and email for git commits (kept out of the repo):\n'
	read -rp "    Name:  " name
	read -rp "    Email: " email
	[[ -n $name && -n $email ]] || { warn "skipped; add them to ~/.config/git/user later"; return; }
	printf '[user]\n\tname = %s\n\temail = %s\n' "$name" "$email" >"$HOME/.config/git/user"
	ok "git identity saved"
}

wallpaper() {
	local img
	img=$(sed -n 's/^\s*path\s*=\s*//p' "$HOME/.config/hypr/wallpaper.conf" 2>/dev/null)
	img=${img/#\~/$HOME}
	[[ -f $img ]] && { echo "$img"; return; }
	find "$HOME/Pictures/Wallpapers" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.png' -o -iname '*.webp' \) 2>/dev/null | head -1
}

copy_wallpapers() {
	local dir=$HOME/Pictures/Wallpapers n=0 f
	mkdir -p "$dir"
	for f in "$repo"/wallpapers/*.jpg; do
		[[ -e $dir/${f##*/} ]] || { cp "$f" "$dir/" && n=$((n + 1)); }
	done
	((n)) && ok "$n wallpapers in ~/Pictures/Wallpapers"
	return 0
}

generate_colors() {
	local img
	img=$(wallpaper)
	if [[ -z $img ]]; then
		warn "no wallpaper found; put images in ~/Pictures/Wallpapers, then run: ~/.config/hypr/scripts/theme.sh <image>"
		return
	fi
	if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
		"$HOME/.config/hypr/scripts/theme.sh" "$img" >/dev/null 2>&1 && ok "colors from ${img/#$HOME/\~}" || bad "theme.sh failed"
	else
		local palette
		palette=$(python3 -I "$HOME/.config/hypr/scripts/theme-palette.py" "$img") &&
			matugen image "$img" --mode "$(jq -r .theme.mode <<<"$palette")" \
				--type "$(jq -r .theme.scheme <<<"$palette")" --source-color-index 0 \
				--import-json-string "$(jq -c --arg wallpaper "$img" '. + {wallpaper: $wallpaper}' <<<"$palette")" --quiet &&
			ok "colors from ${img/#$HOME/\~}" || bad "matugen failed"
	fi
}

reload_desktop() {
	[[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || return 0
	hyprctl reload >/dev/null && ok "Hyprland reloaded"
	qs kill >/dev/null 2>&1
	hyprctl dispatch 'hl.dsp.exec_cmd("~/.config/hypr/scripts/shell.sh")' >/dev/null && ok "Quickshell restarted"
}

cmd_install() {
	printf '%spikadots install%s  (%s)\n' "$bold" "$reset" "${repo/#$HOME/\~}"
	step "Packages"
	install_packages
	step "Links"
	link_packages
	git_identity
	step "Services"
	enable_services
	setup_pywalfox
	setup_zen
	setup_thunderbird
	setup_mpv
	setup_vscode
	setup_default_apps
	step "Colors"
	mkdir -p "$HOME/.local/state/quickshell" "$HOME/Pictures/Screenshots" "$HOME/Videos/Recordings"
	copy_wallpapers
	generate_colors
	mkdir -p "$state" && date +%s >"$state/installed"
	step "Done"
	if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
		reload_desktop
	else
		info "log out and pick the Hyprland session"
	fi
	info "set up displays from the monitor icon in the bar, VPNs from the network panel"
	info "optional: pikadots backup-init · gh auth login · pikadots health"
}

cmd_uninstall() {
	printf '%spikadots uninstall%s\n' "$bold" "$reset"
	info "removes the links into ~ and restores files pikadots backed up; then offers to remove packages"
	confirm "Continue?" || exit 0
	step "Services"
	systemctl --user disable --now pikadots-backup.timer >/dev/null 2>&1 && ok "backup timer stopped"
	python3 -I "$pkgdir/hypr/scripts/kde-theme.py" restore >/dev/null 2>&1 &&
		ok "Qt/KDE theme restored"
	python3 -I "$pkgdir/hypr/scripts/vscode-theme.py" restore >/dev/null 2>&1 &&
		ok "VS Code theme restored"
	step "Links"
	local entry src dst
	for entry in "${links[@]}"; do
		read -r src dst <<<"$entry"
		linked "$src" "$dst" || continue
		rm "$HOME/$dst" && ok "unlinked $dst" || bad "couldn't unlink $dst"
	done
	step "Restore"
	local first
	first=$(ls -1d "$backups"/*/ 2>/dev/null | head -1)
	if [[ -n $first ]]; then
		cp -an "$first". "$HOME"/ && ok "restored files from ${first/#$HOME/\~}"
	else
		info "nothing was backed up"
	fi
	rm -f "$state/installed"
	if [[ -e $greeter_conf || -d $greeter_dir ]]; then
		step "Login screen"
		(cmd_greeter --reset)
	fi
	if [[ -d $splash_dir ]]; then
		step "Boot splash"
		(cmd_splash --reset)
	fi
	step "Packages (optional)"
	remove_packages
	step "Done"
	info "your backups, keyring and git identity are untouched"
}

cmd_health() {
	printf '%spikadots health%s\n' "$bold" "$reset"

	step "Packages"
	local missing
	missing=$(missing_packages)
	[[ -z $missing ]] && ok "all $(wanted_packages | wc -l) packages installed" || bad "missing: $(echo $missing)"
	local aur
	aur=$(list aur.txt | xargs -r pacman -T 2>/dev/null)
	[[ -z $aur ]] || warn "AUR packages missing: $(echo $aur)"

	step "Links"
	local entry src dst
	for entry in "${links[@]}"; do
		read -r src dst <<<"$entry"
		[[ -e $pkgdir/$src ]] || continue
		linked "$src" "$dst" && ok "~/$dst" || bad "~/$dst isn't linked"
	done

	step "Services"
	local s
	for s in "${system_services[@]}" ; do
		systemctl is-active -q "$s" && ok "$s" || bad "$s not running"
	done
	for s in "${services[@]}"; do
		systemctl --user is-active -q "$s" && ok "$s" || bad "$s not running"
	done
	if systemctl --user is-enabled -q pikadots-backup.timer 2>/dev/null; then
		ok "backup timer (next: $(systemctl --user list-timers pikadots-backup.timer --no-legend | awk '{print $1, $2, $3}'))"
	else
		warn "daily backup not enabled (pikadots backup-init)"
	fi

	step "Desktop"
	if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
		local errors
		errors=$(hyprctl configerrors 2>/dev/null | grep -v '^\s*$')
		[[ -z $errors ]] && ok "Hyprland config loads without errors" || bad "Hyprland config errors: $errors"
		local notifier
		notifier=$(busctl --user status org.freedesktop.Notifications 2>/dev/null | sed -n 's/^Comm=//p')
		[[ $notifier == qs || $notifier == quickshell ]] && ok "Quickshell shows notifications" ||
			bad "notifications are handled by ${notifier:-nothing}, not Quickshell (run repair)"
		if pgrep -x qs >/dev/null || pgrep -x quickshell >/dev/null; then
			errors=$(qs log 2>/dev/null | awk '/Reloading configuration/ { buf = "" } /ERROR/ { buf = $0 } END { print buf }')
			[[ -z $errors ]] && ok "Quickshell running" || bad "Quickshell: $(sed 's/\x1b\[[0-9;]*m//g' <<<"$errors")"
		else
			bad "Quickshell isn't running"
		fi
	else
		info "not in a Hyprland session; skipped"
	fi
	[[ -f $HOME/.local/state/theme/quickshell.json ]] && ok "wallpaper colors generated" || bad "no wallpaper colors (run repair)"
	local settings=$HOME/.config/pikadots/settings.json
	if [[ ! -f $settings ]]; then
		ok "Settings app: defaults (nothing changed yet)"
	elif jq -e . "$settings" >/dev/null 2>&1; then
		ok "Settings app choices ($(jq '[.hypr // {} | keys[]] | length' "$settings") Hyprland option(s) changed)"
	else
		bad "Settings app file is not valid JSON: ${settings/#$HOME/\~} (fix or delete it)"
	fi
	local frag=$pkgdir/quickshell/shaders/glass.frag
	if [[ ! -f $frag.qsb ]]; then
		bad "glass shader not built (run ~/.config/hypr/scripts/shaders.sh)"
	elif [[ $frag -nt $frag.qsb ]]; then
		warn "glass shader is older than its source (run ~/.config/hypr/scripts/shaders.sh)"
	else
		ok "glass shader built ($(jq -r '.glass.preset // "frosted"' "$settings" 2>/dev/null || echo frosted) preset)"
	fi
	pgrep -x hypridle >/dev/null && ok "hypridle running (idle timers)" || warn "hypridle isn't running (~/.config/hypr/scripts/idle.sh starts it)"
	if command -v pywalfox >/dev/null; then
		grep -qs pywalfox-host "${pywalfox_manifests[0]}" && ok "browser colors (Pywalfox helper)" ||
			bad "Pywalfox helper not set up for the browsers (run repair)"
	fi

	step "Developer"
	[[ -f $HOME/.config/git/user ]] && ok "git identity: $(git config --get user.name) <$(git config --get user.email)>" || bad "no git identity (~/.config/git/user)"
	busctl --user status org.freedesktop.secrets >/dev/null 2>&1 && ok "keyring (Secret Service) available" || warn "keyring not running yet (it starts on first use)"
	[[ -S ${XDG_RUNTIME_DIR:-/run/user/$UID}/gcr/ssh ]] && ok "SSH agent socket" || bad "no SSH agent socket"
	if command -v gh >/dev/null; then
		gh auth status >/dev/null 2>&1 && ok "GitHub CLI signed in" || warn "GitHub CLI not signed in (gh auth login)"
	fi
	[[ -f $HOME/.config/pikadots/calendar.url ]] && ok "calendar link set" || info "no calendar link (~/.config/pikadots/calendar.url)"
	if [[ -f $repo/docs/keybindings.md ]]; then
		local drift
		drift=$(cmd_docs_check --summary 2>/dev/null)
		if [[ $drift == "0 0" ]]; then
			ok "keybinding docs match keybinds.lua"
		elif [[ -n $drift ]]; then
			warn "keybinding docs: ${drift% *} bind(s) undocumented, ${drift#* } row(s) with unbound keys (pikadots docs-check)"
		fi
	fi

	step "Login and boot"
	check_greeter

	step "Snapshots"
	check_snapshots

	step "Backups"
	local status="$state/backup.json"
	if [[ -f $status ]]; then
		local time okv age
		time=$(jq -r .time "$status") okv=$(jq -r .ok "$status")
		age=$((($(date +%s) - time) / 3600))
		if [[ $okv == true ]]; then
			((age <= 48)) && ok "last backup ${age} h ago ($(jq -r .snapshots "$status") snapshots)" || bad "last backup ${age} h ago"
		else
			bad "last backup failed: $(jq -r .message "$status")"
		fi
	else
		warn "no backup yet"
	fi

	if is_asus && command -v asusctl >/dev/null; then
		step "Laptop"
		local limit
		limit=$(cat /sys/class/power_supply/BAT0/charge_control_end_threshold 2>/dev/null)
		[[ ${limit:-100} -lt 100 ]] && ok "battery charge limit ${limit}%" || warn "no battery charge limit (battery panel → Battery care)"
	fi

	printf '\n'
	if ((problems == 0)); then
		printf '%s%sAll good.%s\n' "$bold" "$green" "$reset"
	else
		printf '%s%s%d problem(s).%s Run %spikadots repair%s to fix them.\n' "$bold" "$red" "$problems" "$reset" "$bold" "$reset"
		exit 1
	fi
}

cmd_repair() {
	printf '%spikadots repair%s\n' "$bold" "$reset"
	step "Packages"
	install_packages
	step "Links"
	link_packages
	step "Services"
	enable_services
	setup_pywalfox
	setup_zen
	setup_thunderbird
	setup_mpv
	setup_vscode
	setup_default_apps
	step "Colors"
	generate_colors
	step "Reload"
	reload_desktop
	printf '\nRun %spikadots health%s to check.\n' "$bold" "$reset"
}

cmd_update() {
	printf '%spikadots update%s\n' "$bold" "$reset"
	step "Repository"
	if git -C "$repo" remote get-url origin >/dev/null 2>&1; then
		local before
		before=$(git -C "$repo" rev-parse HEAD)
		git -C "$repo" pull --rebase --autostash --quiet || die "git pull failed; resolve it in $repo"
		if [[ $(git -C "$repo" rev-parse HEAD) == "$before" ]]; then
			ok "already up to date"
			info "nothing new, so no repair; run pikadots repair to check anyway"
			return
		fi
		ok "updated:"
		git -C "$repo" log --oneline "$before..HEAD" | sed 's/^/    /'
	else
		warn "no remote set; nothing to pull"
		return
	fi
	if snapper_root; then
		step "Snapshot"
		snapshot_before_update
	fi
	cmd_repair
	snapshot_after_update
}

cmd_backup_init() {
	printf '%spikadots backup-init%s\n' "$bold" "$reset"
	local config=$HOME/.config/pikadots/backup-repo repo_dir
	if [[ ! -f $config ]]; then
		read -rp "  Back up to (a cloud-synced folder keeps a copy off the machine) [~/Backups/restic]: " repo_dir
		mkdir -p "$(dirname "$config")"
		echo "${repo_dir:-~/Backups/restic}" >"$config"
	fi
	repo_dir=$(sed "s|^~|$HOME|" "$config")
	local password_file=$HOME/.config/restic/password
	mkdir -p "$(dirname "$password_file")" && chmod 700 "$(dirname "$password_file")"
	if [[ ! -f $password_file ]]; then
		head -c 33 /dev/urandom | base64 >"$password_file"
		chmod 600 "$password_file"
		ok "password created: ${password_file/#$HOME/\~}"
		warn "save a copy of it somewhere safe (password manager); without it the backup can't be read"
	fi
	if [[ -f $repo_dir/config ]]; then
		ok "repository exists: ${repo_dir/#$HOME/\~}"
	else
		mkdir -p "$(dirname "$repo_dir")"
		RESTIC_PASSWORD_FILE=$password_file restic init --repo "$repo_dir" >/dev/null && ok "repository created: ${repo_dir/#$HOME/\~}" || die "restic init failed"
	fi
	systemctl --user daemon-reload
	systemctl --user enable --now pikadots-backup.timer >/dev/null && ok "daily backup enabled"
	info "first backup: pikadots backup"
}

cmd_backup() {
	"$HOME/.local/bin/pikadots-backup" && ok "backed up ($(jq -r '.snapshots' "$state/backup.json") snapshots)"
}

settings_files=(.config/pikadots/settings.json .local/state/pikadots/hypr-settings.lua
	.local/state/pikadots/autostart.lua .local/state/pikadots/window-rules.lua)

cmd_export() {
	local out=${1:-$HOME/pikadots-settings-$(date +%F).tar.gz} tmp img f
	[[ -f $HOME/.config/pikadots/settings.json ]] || die "no settings yet (~/.config/pikadots/settings.json)"
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' RETURN
	for f in "${settings_files[@]}" .face; do
		[[ -f $HOME/$f ]] || continue
		mkdir -p "$tmp/$(dirname "$f")"
		cp "$HOME/$f" "$tmp/$f"
	done
	img=$(wallpaper)
	if [[ -n $img ]]; then
		mkdir -p "$tmp/wallpaper"
		cp "$img" "$tmp/wallpaper/"
	fi
	jq -n --arg host "$(cat /etc/hostname 2>/dev/null)" --arg date "$(date -Iseconds)" \
		--arg wallpaper "${img##*/}" '{version: 1, host: $host, date: $date, wallpaper: $wallpaper}' >"$tmp/pikadots-export.json"
	tar -czf "$out" -C "$tmp" . || die "couldn't write $out"
	ok "saved ${out/#$HOME/\~} ($(du -h "$out" | cut -f1))"
	info "on the new machine, after install: pikadots import ${out##*/}"
}

cmd_import() {
	local file=${1:-} tmp backup f img
	[[ -f $file ]] || die "usage: pikadots import FILE (from pikadots export, or a settings.json)"
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' RETURN
	if jq -e .appearance "$file" >/dev/null 2>&1; then
		mkdir -p "$tmp/.config/pikadots"
		cp "$file" "$tmp/.config/pikadots/settings.json"
	else
		tar -xzf "$file" -C "$tmp" 2>/dev/null || die "not a pikadots export: $file"
		jq -e .appearance "$tmp/.config/pikadots/settings.json" >/dev/null 2>&1 || die "no settings in $file"
	fi
	printf '%spikadots import%s\n' "$bold" "$reset"
	[[ -f $tmp/pikadots-export.json ]] && info "from $(jq -r '"\(.host) on \(.date[:10])"' "$tmp/pikadots-export.json")"

	step "Files"
	qs kill >/dev/null 2>&1
	backup=$backups/import-$(date +%Y%m%d-%H%M%S)
	for f in "${settings_files[@]}" .face; do
		[[ -f $tmp/$f ]] || continue
		if [[ -f $HOME/$f ]]; then
			mkdir -p "$backup/$(dirname "$f")"
			cp "$HOME/$f" "$backup/$f"
		fi
		mkdir -p "$HOME/$(dirname "$f")"
		cp "$tmp/$f" "$HOME/$f"
		ok "${f}"
	done
	[[ -d $backup ]] && info "previous files: ${backup/#$HOME/\~}"
	img=$(find "$tmp/wallpaper" -maxdepth 1 -type f 2>/dev/null | head -1)
	if [[ -n $img ]]; then
		mkdir -p "$HOME/Pictures/Wallpapers"
		[[ -e $HOME/Pictures/Wallpapers/${img##*/} ]] || cp "$img" "$HOME/Pictures/Wallpapers/"
		img=$HOME/Pictures/Wallpapers/${img##*/}
		printf 'wallpaper {\n    monitor =\n    path = %s\n    fit_mode = cover\n}\n' "${img/#$HOME/\~}" >"$HOME/.config/hypr/wallpaper.conf"
		ok "wallpaper ${img/#$HOME/\~}"
	fi

	step "Apply"
	generate_colors
	if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
		local scripts=$HOME/.config/hypr/scripts s
		for s in fonts.sh icons.sh accessibility.sh "clipboard.sh watch"; do
			$scripts/$s >/dev/null 2>&1 || warn "${s%% *} failed"
		done
		setsid -f "$scripts/idle.sh" >/dev/null 2>&1
		ok "fonts, icons, accessibility, clipboard, idle timers"
		reload_desktop
	else
		info "log in to Hyprland to see everything applied"
	fi
}

snapper_root() { command -v snapper >/dev/null && [[ -f /etc/snapper/configs/root ]]; }

check_snapshots() {
	if ! command -v snapper >/dev/null; then
		info "snapper not installed; skipped"
		return
	fi
	local json source count latest age
	json=$("$pkgdir/hypr/scripts/snapshots.sh" 2>/dev/null)
	if [[ $(jq -r '.config // false' <<<"$json" 2>/dev/null) != true ]]; then
		warn "snapper has no root config (sudo snapper -c root create-config /)"
		return
	fi
	pacman -Q snap-pac >/dev/null 2>&1 && ok "snapper root config, snap-pac snapshots every pacman run" || ok "snapper root config"
	source=$(jq -r .source <<<"$json")
	if [[ -z $source ]]; then
		info "listing snapshots needs root here, so their age isn't checked"
		return
	fi
	count=$(jq -r .count <<<"$json") latest=$(jq -r '.latest // 0' <<<"$json")
	[[ $source == grub-btrfs ]] && source=" in the boot menu" || source=""
	if ((count == 0)); then
		warn "no snapshots yet"
		return
	fi
	age=$(($(date +%s) - latest))
	if ((age >= 7 * 86400)); then
		warn "latest snapshot $((age / 86400)) days ago ($count$source)"
	elif ((age >= 48 * 3600)); then
		ok "latest snapshot $((age / 86400)) days ago ($count$source)"
	elif ((age >= 3600)); then
		ok "latest snapshot $((age / 3600)) h ago ($count$source)"
	else
		ok "latest snapshot $((age / 60)) min ago ($count$source)"
	fi
}

update_snapshot=
snapshot_before_update() {
	snapper_root || return 0
	if pacman -Q snap-pac >/dev/null 2>&1; then
		info "snap-pac snapshots the system around pacman, so no extra snapshot"
		return 0
	fi
	update_snapshot=$(sudo snapper -c root create --type pre --cleanup-algorithm number --print-number \
		--description "pikadots update") && ok "snapshot $update_snapshot taken (roll back with snapper or the boot menu)" ||
		{ update_snapshot=; warn "couldn't take a snapshot; updating anyway"; }
}

snapshot_after_update() {
	[[ -n $update_snapshot ]] || return 0
	sudo snapper -c root create --type post --pre-number "$update_snapshot" --cleanup-algorithm number \
		--description "pikadots update" >/dev/null && ok "snapshot after the update paired with $update_snapshot"
}

display_manager() {
	local unit
	unit=$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null)
	unit=${unit##*/}
	echo "${unit%.service}"
}

greeter_dir=/var/lib/pikadots/greeter
greeter_conf=/etc/plasmalogin.conf.d/pikadots.conf
greeter_kdeglobals=/var/lib/plasmalogin/.config/kdeglobals

greeter_colors() {
	grep -qs '^PikadotsApplied=true' "$HOME/.config/kdeglobals" || return 1
	awk '
		/^\[/ { keep = /^\[(Colors|ColorEffects):/ || /^\[WM\]/; general = /^\[General\]/; if (keep) print; next }
		keep { print }
		general && /^(ColorScheme|AccentColor)=/ { extra = extra $0 "\n" }
		END { if (extra != "") printf "[General]\n%s", extra }
	' "$HOME/.config/kdeglobals"
}

check_greeter() {
	local dm img copy
	dm=$(display_manager)
	case $dm in
	plasmalogin)
		if [[ -f $greeter_conf ]]; then
			img=$(wallpaper)
			copy=$(find "$greeter_dir" -maxdepth 1 -name 'wallpaper.*' 2>/dev/null | head -1)
			if [[ -n $img && -n $copy ]] && ! cmp -s "$img" "$copy"; then
				warn "login screen shows an older wallpaper (pikadots greeter)"
			else
				ok "login screen uses the wallpaper and colors (Plasma Login Manager)"
			fi
		else
			info "login screen: Plasma Login Manager defaults (pikadots greeter themes it)"
		fi
		;;
	"") info "no display manager" ;;
	*) info "login screen: $dm (pikadots greeter supports Plasma Login Manager only)" ;;
	esac
	if command -v plymouth-set-default-theme >/dev/null; then
		local theme
		theme=$(plymouth-set-default-theme 2>/dev/null)
		[[ $theme == pikadots ]] && ok "boot splash: pikadots" || info "boot splash: ${theme:-none} (pikadots splash themes it)"
	fi
}

cmd_greeter() {
	printf '%spikadots greeter%s\n' "$bold" "$reset"
	local dm img ext tmp colors
	dm=$(display_manager)
	[[ $dm == plasmalogin ]] ||
		die "only Plasma Login Manager is supported (this machine uses ${dm:-no display manager})"
	if [[ ${1:-} == --reset ]]; then
		if [[ ! -e $greeter_conf && ! -d $greeter_dir ]]; then
			ok "the login screen already uses its own settings"
			return
		fi
		info "with sudo, this will:"
		info "  remove $greeter_conf and $greeter_dir"
		info "  put back the login screen's previous colors ($greeter_kdeglobals)"
		confirm "Reset the login screen?" || exit 0
		sudo rm -f "$greeter_conf" || die "sudo failed"
		if sudo test -f "$greeter_dir/kdeglobals.orig"; then
			sudo install -o plasmalogin -g plasmalogin -m 644 "$greeter_dir/kdeglobals.orig" "$greeter_kdeglobals"
		elif sudo test -f "$greeter_dir/kdeglobals.none"; then
			sudo rm -f "$greeter_kdeglobals"
		fi
		sudo rm -rf "$greeter_dir"
		ok "login screen back to its defaults (shows at the next login)"
		return
	fi
	img=$(wallpaper)
	[[ -n $img ]] || die "no wallpaper set"
	ext=${img##*.}
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' RETURN
	cat >"$tmp/pikadots.conf" <<-EOF
		[Greeter]
		WallpaperPluginId=org.kde.image

		[Greeter][Wallpaper][org.kde.image][General]
		Image=file://$greeter_dir/wallpaper.${ext,,}
	EOF
	colors=$(greeter_colors) && printf '%s\n' "$colors" >"$tmp/kdeglobals"

	info "with sudo, this will:"
	info "  copy ${img/#$HOME/\~} to $greeter_dir/wallpaper.${ext,,}"
	info "  write $greeter_conf:"
	sed 's/^/        /' "$tmp/pikadots.conf"
	if [[ -f $tmp/kdeglobals ]]; then
		info "  give the login screen the wallpaper colors ($(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | grep -q dark && echo dark || echo light), accent $(jq -r .accent "$HOME/.local/state/theme/quickshell.json" 2>/dev/null)):"
		info "    $greeter_kdeglobals (the current one is kept for --reset)"
	else
		info "  colors stay as they are (the Qt/KDE theme isn't applied; Settings > Appearance)"
	fi
	grep -qs '^\[Greeter\]\[Wallpaper\]' /etc/plasmalogin.conf &&
		warn "/etc/plasmalogin.conf sets its own wallpaper, which wins over pikadots.conf; clear it in System Settings > Login Screen"
	confirm "Apply?" || exit 0

	sudo install -Dm 644 "$img" "$greeter_dir/wallpaper.${ext,,}" || die "sudo failed"
	sudo install -Dm 644 "$tmp/pikadots.conf" "$greeter_conf"
	if [[ -f $tmp/kdeglobals ]]; then
		if ! sudo test -e "$greeter_dir/kdeglobals.orig" && ! sudo test -e "$greeter_dir/kdeglobals.none"; then
			if sudo test -f "$greeter_kdeglobals"; then
				sudo cp "$greeter_kdeglobals" "$greeter_dir/kdeglobals.orig"
			else
				sudo touch "$greeter_dir/kdeglobals.none"
			fi
		fi
		sudo install -d -o plasmalogin -g plasmalogin -m 755 "${greeter_kdeglobals%/*}"
		sudo install -o plasmalogin -g plasmalogin -m 644 "$tmp/kdeglobals" "$greeter_kdeglobals"
	fi
	ok "login screen updated (shows at the next login; pikadots greeter --reset undoes it)"
	info "run it again after changing the wallpaper"
}

splash_dir=/usr/share/plymouth/themes/pikadots

rgb() { awk -v h="${1#\#}" 'BEGIN { printf "%.3f, %.3f, %.3f", strtonum("0x" substr(h, 1, 2)) / 255, strtonum("0x" substr(h, 3, 2)) / 255, strtonum("0x" substr(h, 5, 2)) / 255 }'; }

splash_logo() {
	local id f
	id=$(sed -n 's/^LOGO=//p' /etc/os-release 2>/dev/null | tr -d '"')
	for f in ${id:+/usr/share/icons/Papirus/64x64/apps/distributor-logo-$id.svg /usr/share/icons/$id.svg \
		/usr/share/icons/hicolor/scalable/apps/$id.svg /usr/share/pixmaps/$id.svg /usr/share/pixmaps/$id.png} \
		/usr/share/icons/Papirus/64x64/apps/distributor-logo-archlinux.svg /usr/share/pixmaps/archlinux-logo.svg; do
		[[ -f $f ]] && { echo "$f"; return; }
	done
	return 1
}

cmd_splash() {
	printf '%spikadots splash%s\n' "$bold" "$reset"
	command -v plymouth-set-default-theme >/dev/null || die "plymouth isn't installed"
	local current previous palette=$HOME/.local/state/theme/quickshell.json
	current=$(plymouth-set-default-theme)
	if [[ ${1:-} == --reset ]]; then
		if [[ $current != pikadots && ! -d $splash_dir ]]; then
			ok "the boot splash is already $current"
			return
		fi
		previous=$(cat "$state/splash-previous" 2>/dev/null || cat "$splash_dir/previous" 2>/dev/null)
		info "with sudo, this will:"
		if [[ -n $previous ]]; then
			info "  switch the boot splash from $current back to $previous and rebuild the initramfs"
		else
			info "  no earlier splash was recorded, so switch to the distribution default and rebuild the initramfs"
		fi
		info "  remove $splash_dir"
		confirm "Restore ${previous:-the default splash}?" || exit 0
		if [[ -n $previous && -d /usr/share/plymouth/themes/$previous ]]; then
			sudo plymouth-set-default-theme -R "$previous" || die "plymouth-set-default-theme failed"
		else
			sudo plymouth-set-default-theme --reset --rebuild-initrd || die "plymouth-set-default-theme failed"
			previous=$(plymouth-set-default-theme)
		fi
		sudo rm -rf "$splash_dir"
		rm -f "$state/splash-previous"
		ok "boot splash: $previous"
		return
	fi
	[[ -f $palette ]] || die "no wallpaper colors yet (pikadots repair)"
	local base text subtext accent surface logo tmp
	base=$(jq -r .base "$palette") text=$(jq -r .text "$palette") subtext=$(jq -r .subtext "$palette")
	accent=$(jq -r .accent "$palette") surface=$(jq -r .surface "$palette")
	logo=$(splash_logo) || die "no distribution logo found"
	command -v magick >/dev/null || die "imagemagick isn't installed"
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' RETURN
	magick -background none -density 600 "$logo" -resize 160x160 -fill "$text" -colorize 100 "$tmp/logo.png" &&
		magick -size 72x72 xc:none -fill none -strokewidth 6 -stroke "$surface" -draw 'circle 36,36 36,6' \
			-stroke "$accent" -draw 'arc 6,6 66,66 -90,30' -depth 8 "$tmp/spinner.png" || die "couldn't draw the splash images"
	cp "$pkgdir/plymouth/pikadots.plymouth" "$tmp/"
	sed -e "s/@BASE@/$(rgb "$base")/g" -e "s/@TEXT@/$(rgb "$text")/g" -e "s/@SUBTEXT@/$(rgb "$subtext")/g" \
		-e "s/@ACCENT@/$(rgb "$accent")/g" "$pkgdir/plymouth/pikadots.script" >"$tmp/pikadots.script"

	info "with sudo, this will:"
	info "  install a pikadots theme in $splash_dir: the ${logo##*/} logo over $base, spinner in $accent"
	info "  switch the boot splash from $current to pikadots and rebuild the initramfs (takes a minute)"
	[[ $current == pikadots ]] || info "  remember $current, so pikadots splash --reset can bring it back"
	grep -qw splash /proc/cmdline || warn "the kernel command line has no 'splash', so the splash may not show"
	confirm "Install the boot splash?" || exit 0

	if [[ $current != pikadots ]]; then
		mkdir -p "$state"
		echo "$current" >"$state/splash-previous"
	fi
	sudo install -d "$splash_dir" || die "sudo failed"
	sudo install -m 644 "$tmp"/{pikadots.plymouth,pikadots.script,logo.png,spinner.png} "$splash_dir/"
	[[ -s $state/splash-previous ]] && sudo install -m 644 "$state/splash-previous" "$splash_dir/previous"
	sudo plymouth-set-default-theme -R pikadots || die "plymouth-set-default-theme failed"
	ok "boot splash: pikadots (pikadots splash --reset brings back $(cat "$state/splash-previous" 2>/dev/null || echo the old one))"
	info "run it again after changing the wallpaper"
}

cmd_keybinds() {
	local rel=config/hypr/keybinds.lua
	local modified=0
	if ! git -C "$repo" cat-file -e "HEAD:$rel" 2>/dev/null; then
		modified=-1
	elif ! git -C "$repo" diff --quiet HEAD -- "$rel"; then
		modified=1
	fi
	case ${1:-status} in
		status)
			case $modified in
				-1) echo unknown ;;
				1) echo modified ;;
				*) echo default ;;
			esac
			;;
		reset)
			step "Keybindings"
			if ((modified == 1)); then
				mkdir -p "$backups"
				local copy=$backups/keybinds-$(date +%Y%m%d-%H%M%S).lua
				cp "$repo/$rel" "$copy"
				git -C "$repo" checkout HEAD -- "$rel" && ok "keybinds.lua restored to the default (your edited copy: $copy)"
			elif ((modified == -1)); then
				warn "$repo isn't a git checkout, so keybinds.lua can't be restored"
			else
				ok "keybinds.lua is already the default"
			fi
			if pgrep -x qs >/dev/null && qs ipc call keybinds clear >/dev/null 2>&1; then
				ok "Settings shortcut changes cleared"
			elif [[ -f $HOME/.config/pikadots/settings.json ]]; then
				python3 -I - "$HOME/.config/pikadots/settings.json" <<'PY'
import json, sys
with open(sys.argv[1]) as f:
    data = json.load(f)
data["keybinds"] = {}
with open(sys.argv[1], "w") as f:
    json.dump(data, f, indent=4)
PY
				ok "Settings shortcut changes cleared"
			fi
			mkdir -p "$state"
			printf 'return {}\n' >"$state/keybinds.lua"
			hyprctl reload >/dev/null 2>&1 && ok "Hyprland reloaded"
			;;
		*) die "usage: pikadots keybinds [status|reset]" ;;
	esac
}

cmd_docs_check() {
	python3 -I "$pkgdir/pikadots/docs-check.py" "$repo" "$@"
}

usage() {
	cat <<'EOF'
pikadots: install, check and maintain these dotfiles (Hyprland + Quickshell on Arch/CachyOS).

  pikadots install      packages, links into $HOME (existing files backed up), services, colors
  pikadots uninstall    remove the links, restore the backed-up files, stop the backup timer,
                        undo the Qt/KDE and VS Code themes, then optionally remove the packages
                        pikadots installed
  pikadots health       check packages, links, services, configs, keyring, backups, …
  pikadots repair       fix what health finds: packages, links, services, colors, reloads
  pikadots link         link the files in config/ into $HOME (see the links table)
  pikadots update       pull the repo, then repair if anything new came in (with a snapper
                        snapshot first when snapper is set up and snap-pac isn't)
  pikadots backup       back up now (restic; see pikadots-backup)
  pikadots backup-init  create the backup password and repository, enable the daily backup
  pikadots export [FILE]  save the Settings app's choices, wallpaper and profile picture to one
                        file (default ~/pikadots-settings-DATE.tar.gz) to set up another machine
  pikadots import FILE  apply an exported file (or a settings.json); your current ones are backed up
  pikadots greeter [--reset]  login screen (Plasma Login Manager) with the wallpaper and its colors;
                        shows what it changes, asks, then uses sudo
  pikadots splash [--reset]   boot splash (Plymouth) with the distro logo and an accent spinner;
                        shows what it changes, asks, then uses sudo; --reset restores the old one
  pikadots keybinds [status|reset]  status says whether keybinds.lua differs from the repo's
                        committed one; reset restores it (your edited copy is backed up) and
                        clears the shortcuts changed in Settings > Keybindings
  pikadots docs-check   compare config/hypr/keybinds.lua with docs/keybindings.md
EOF
}

case ${1:-help} in
	install) cmd_install ;;
	link) step "Links"; link_packages ;;
	uninstall) cmd_uninstall ;;
	health | check | doctor) cmd_health ;;
	repair | fix) cmd_repair ;;
	update) cmd_update ;;
	backup) cmd_backup ;;
	backup-init) cmd_backup_init ;;
	export) cmd_export "${2:-}" ;;
	import) cmd_import "${2:-}" ;;
	greeter) cmd_greeter "${2:-}" ;;
	splash) cmd_splash "${2:-}" ;;
	keybinds) cmd_keybinds "${2:-}" ;;
	docs-check) cmd_docs_check ;;
	help | -h | --help) usage ;;
	*) usage; exit 1 ;;
esac
