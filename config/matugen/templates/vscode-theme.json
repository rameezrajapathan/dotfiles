    "terminal.selectionForeground": "{{colors.on_primary_container.default.hex}}",
    "terminalCursor.foreground": "{{colors.primary.default.hex}}",
    "terminalCursor.background": "{{colors.on_primary.default.hex}}",
    "terminal.ansiBlack": "{{colors.surface_container_highest.default.hex}}",
    "terminal.ansiBrightBlack": "{{colors.outline.default.hex}}",
    "terminal.ansiRed": "{{ansi.red}}",
    "terminal.ansiBrightRed": "{{ansi.red}}",
    "terminal.ansiGreen": "{{ansi.green}}",
    "terminal.ansiBrightGreen": "{{ansi.green}}",
    "terminal.ansiYellow": "{{ansi.yellow}}",
    "terminal.ansiBrightYellow": "{{ansi.yellow}}",
    "terminal.ansiBlue": "{{ansi.blue}}",
    "terminal.ansiBrightBlue": "{{ansi.blue}}",
    "terminal.ansiMagenta": "{{ansi.magenta}}",
    "terminal.ansiBrightMagenta": "{{ansi.magenta}}",
    "terminal.ansiCyan": "{{ansi.cyan}}",
    "terminal.ansiBrightCyan": "{{ansi.cyan}}",
    "terminal.ansiWhite": "{{colors.on_surface_variant.default.hex}}",
    "terminal.ansiBrightWhite": "{{colors.on_surface.default.hex}}",
    "terminalCommandDecoration.defaultBackground": "{{colors.outline.default.hex}}",
    "terminalCommandDecoration.successBackground": "{{ansi.green}}",
    "terminalCommandDecoration.errorBackground": "{{ansi.red}}",

    "chat.requestBackground": "{{colors.surface_container.default.hex}}",
    "chat.requestBorder": "#00000000",
    "chat.slashCommandBackground": "{{colors.primary.default.hex}}33",
    "chat.slashCommandForeground": "{{colors.primary.default.hex}}",
    "chat.avatarBackground": "{{colors.secondary_container.default.hex}}",
    "chat.avatarForeground": "{{colors.on_secondary_container.default.hex}}",
    "charts.foreground": "{{colors.on_surface.default.hex}}",
    "charts.lines": "{{colors.outline_variant.default.hex}}",
    "charts.red": "{{ansi.red}}",
    "charts.blue": "{{ansi.blue}}",
    "charts.yellow": "{{ansi.yellow}}",
    "charts.orange": "{{ansi.peach}}",
    "charts.green": "{{ansi.green}}",
    "charts.purple": "{{ansi.mauve}}"
  },
  "semanticTokenColors": {
    "namespace": "{{ansi.yellow}}",
    "class": "{{ansi.yellow}}",
    "enum": "{{ansi.yellow}}",
    "interface": "{{ansi.yellow}}",
    "struct": "{{ansi.yellow}}",
    "type": "{{ansi.yellow}}",
    "typeParameter": "{{ansi.maroon}}",
    "parameter": "{{ansi.maroon}}",
    "variable": "{{colors.on_surface.default.hex}}",
    "variable.readonly": "{{colors.on_surface.default.hex}}",
    "variable.defaultLibrary": "{{ansi.red}}",
    "property": "{{colors.primary.default.hex}}",
    "enumMember": "{{ansi.cyan}}",
    "function": "{{ansi.blue}}",
    "method": "{{ansi.blue}}",
    "function.defaultLibrary": "{{ansi.blue}}",
    "macro": "{{ansi.cyan}}",
    "keyword": "{{ansi.mauve}}",
    "modifier": "{{ansi.mauve}}",
    "comment": { "foreground": "{{colors.outline.default.hex}}", "italic": true },
    "string": "{{ansi.green}}",
    "number": "{{ansi.peach}}",
    "regexp": "{{ansi.magenta}}",
    "operator": "{{ansi.sky}}",
    "decorator": "{{ansi.peach}}",
    "label": "{{ansi.sapphire}}",
    "selfKeyword": "{{ansi.red}}",
    "*.deprecated": { "strikethrough": true }
  },
  "tokenColors": [
    {
      "name": "Plain text",
      "scope": ["source", "text", "variable", "meta.definition.variable", "variable.other.readwrite"],
      "settings": { "foreground": "{{colors.on_surface.default.hex}}" }
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "{{colors.outline.default.hex}}", "fontStyle": "italic" }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier", "keyword.other.using", "keyword.other.import", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python", "keyword.operator.wordlike"],
      "settings": { "foreground": "{{ansi.mauve}}" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator.key-value", "storage.type.function.arrow"],
      "settings": { "foreground": "{{ansi.sky}}" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "punctuation.definition.tag", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "{{colors.on_surface_variant.default.hex}}" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "markup.inline.raw.string", "constant.other.symbol"],
      "settings": { "foreground": "{{ansi.green}}" }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": ["constant.character.escape", "string.regexp", "punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": { "foreground": "{{ansi.magenta}}" }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant", "constant.numeric", "constant.language", "constant.character", "support.constant", "variable.other.constant", "variable.other.enummember"],
      "settings": { "foreground": "{{ansi.peach}}" }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "variable.function", "entity.name.method"],
      "settings": { "foreground": "{{ansi.blue}}" }
    },
    {
      "name": "Types and classes",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "entity.other.inherited-class", "support.type", "support.class", "storage.type.primitive", "storage.type.built-in", "entity.name.type.module"],
      "settings": { "foreground": "{{ansi.yellow}}" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.parameter", "entity.name.variable.parameter"],
      "settings": { "foreground": "{{ansi.maroon}}", "fontStyle": "italic" }
    },
    {
      "name": "Properties and keys",
      "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key", "entity.name.tag.yaml", "support.type.property-name", "meta.property-name"],
      "settings": { "foreground": "{{colors.primary.default.hex}}" }
    },
    {
      "name": "Language variables (this, self)",
      "scope": ["variable.language", "variable.language.this", "variable.language.self", "variable.language.super"],
      "settings": { "foreground": "{{ansi.red}}", "fontStyle": "italic" }
    },
    {
      "name": "Builtins",
      "scope": ["support.function.builtin", "support.variable", "variable.other.builtin"],
      "settings": { "foreground": "{{ansi.red}}" }
    },
    {
      "name": "Decorators and macros",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "entity.name.function.macro", "meta.preprocessor", "keyword.control.directive"],
      "settings": { "foreground": "{{ansi.peach}}" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "meta.tag.sgml", "markup.deleted.git_gutter"],
      "settings": { "foreground": "{{ansi.blue}}" }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.id", "entity.other.attribute-name.class"],
      "settings": { "foreground": "{{ansi.yellow}}", "fontStyle": "italic" }
    },
    {
      "name": "CSS",
      "scope": ["support.type.property-name.css", "meta.property-name.css"],
      "settings": { "foreground": "{{colors.primary.default.hex}}" }
    },
    {
      "name": "CSS values and units",
      "scope": ["support.constant.property-value.css", "keyword.other.unit", "constant.other.color"],
      "settings": { "foreground": "{{ansi.peach}}" }
    },
    {
      "name": "Labels",
      "scope": ["entity.name.label", "constant.other.reference.link"],
      "settings": { "foreground": "{{ansi.sapphire}}" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section", "markup.heading entity.name"],
      "settings": { "foreground": "{{colors.primary.default.hex}}", "fontStyle": "bold" }
    },
    {
      "name": "Markdown emphasis",
      "scope": ["markup.bold"],
      "settings": { "foreground": "{{ansi.peach}}", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "{{ansi.magenta}}", "fontStyle": "italic" }
    },
    {
      "name": "Markdown strikethrough",
      "scope": ["markup.strikethrough"],
      "settings": { "fontStyle": "strikethrough" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
      "settings": { "foreground": "{{ansi.green}}" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link", "meta.link"],
      "settings": { "foreground": "{{ansi.blue}}" }
    },
    {
      "name": "Markdown quotes and lists",
      "scope": ["markup.quote", "punctuation.definition.list.begin.markdown", "beginning.punctuation.definition.list"],
      "settings": { "foreground": "{{ansi.cyan}}" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "{{ansi.green}}" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "{{ansi.red}}" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed", "meta.diff.range", "meta.diff.header"],
      "settings": { "foreground": "{{ansi.yellow}}" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "{{colors.error.default.hex}}" }
    },
    {
      "name": "JSON keys by depth",
      "scope": ["source.json meta.structure.dictionary.json support.type.property-name.json"],
      "settings": { "foreground": "{{colors.primary.default.hex}}" }
    },
    {
      "name": "JSON nested keys",
      "scope": ["source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"],
      "settings": { "foreground": "{{ansi.blue}}" }
    }
  ]
}
