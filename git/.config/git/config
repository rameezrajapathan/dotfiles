# Your name and email go in ~/.config/git/user (not in the dotfiles):
#   [user]
#       name = Your Name
#       email = you@example.com
[include]
	path = ~/.config/git/user

[init]
	defaultBranch = main

# Diffs through delta. The ansi theme uses the terminal's colors, which follow the wallpaper.
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = ansi
[diff]
	colorMoved = default
[merge]
	conflictStyle = zdiff3

# Passwords and tokens for HTTPS remotes live in the keyring (gnome-keyring)
[credential]
	helper = /usr/lib/git-core/git-credential-libsecret
