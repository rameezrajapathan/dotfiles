# Generated by matugen from {{image}}
# btop theme, like the rest of the desktop: kitty's background shows through (theme_background =
# false in btop.conf), quiet outline_variant boxes with accent titles, the selection in
# secondary_container like superfile and VS Code, and the terminal's colors for the graphs.
# btop.conf selects it (color_theme = "wallpaper"); theme.sh sends USR2 to reload it.

# Only used where the background isn't transparent (menus)
theme[main_bg]="{{colors.surface.default.hex}}"
theme[main_fg]="{{colors.on_surface.default.hex}}"

# Box titles, the keys in them (hotkeys) and the line between process columns
theme[title]="{{colors.primary.default.hex}}"
theme[hi_fg]="{{colors.tertiary.default.hex}}"
theme[div_line]="{{colors.outline_variant.default.hex}}"

# Selected process row and anything greyed out
theme[selected_bg]="{{colors.secondary_container.default.hex}}"
theme[selected_fg]="{{colors.on_secondary_container.default.hex}}"
theme[inactive_fg]="{{colors.outline.default.hex}}"

# Text drawn over graphs, the empty part of meters, and misc process details (tree lines, graphs)
theme[graph_text]="{{colors.on_surface_variant.default.hex}}"
theme[meter_bg]="{{colors.surface_container_highest.default.hex}}"
theme[proc_misc]="{{colors.secondary.default.hex}}"

# Box outlines: all the same quiet line, like kitty's and superfile's borders
theme[cpu_box]="{{colors.outline_variant.default.hex}}"
theme[mem_box]="{{colors.outline_variant.default.hex}}"
theme[net_box]="{{colors.outline_variant.default.hex}}"
theme[proc_box]="{{colors.outline_variant.default.hex}}"

# Gradients go from low to high use: the accent while things are calm, red when they're busy
theme[temp_start]="{{ansi.blue}}"
theme[temp_mid]="{{ansi.yellow}}"
theme[temp_end]="{{ansi.red}}"

theme[cpu_start]="{{colors.primary.default.hex}}"
theme[cpu_mid]="{{ansi.mauve}}"
theme[cpu_end]="{{ansi.red}}"

theme[free_start]="{{colors.primary_container.default.hex}}"
theme[free_mid]="{{ansi.sapphire}}"
theme[free_end]="{{ansi.sky}}"

theme[cached_start]="{{colors.tertiary_container.default.hex}}"
theme[cached_mid]="{{ansi.lavender}}"
theme[cached_end]="{{ansi.mauve}}"

theme[available_start]="{{colors.secondary_container.default.hex}}"
theme[available_mid]="{{ansi.cyan}}"
theme[available_end]="{{ansi.green}}"

theme[used_start]="{{ansi.yellow}}"
theme[used_mid]="{{ansi.peach}}"
theme[used_end]="{{ansi.red}}"

theme[download_start]="{{colors.primary_container.default.hex}}"
theme[download_mid]="{{colors.primary.default.hex}}"
theme[download_end]="{{ansi.sky}}"

theme[upload_start]="{{colors.tertiary_container.default.hex}}"
theme[upload_mid]="{{colors.tertiary.default.hex}}"
theme[upload_end]="{{ansi.magenta}}"

theme[process_start]="{{colors.primary.default.hex}}"
theme[process_mid]="{{ansi.mauve}}"
theme[process_end]="{{ansi.red}}"
